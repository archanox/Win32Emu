@using Win32Emu

<div class="win32-messagebox-overlay" @onclick="HandleBackdropClick">
	<div class="win32-messagebox" @onclick:stopPropagation="true">
		<div class="win32-messagebox-titlebar">
			<span class="win32-messagebox-title">@Info.Caption</span>
		</div>
		<div class="win32-messagebox-content">
			<div class="win32-messagebox-text">
				@Info.Text
			</div>
		</div>
		<div class="win32-messagebox-buttons">
			@if (ShowOkButton)
			{
				<button class="win32-button" @onclick="() => HandleButtonClick(ButtonResult.Ok)">OK</button>
			}
			@if (ShowCancelButton)
			{
				<button class="win32-button" @onclick="() => HandleButtonClick(ButtonResult.Cancel)">Cancel</button>
			}
			@if (ShowYesButton)
			{
				<button class="win32-button" @onclick="() => HandleButtonClick(ButtonResult.Yes)">Yes</button>
			}
			@if (ShowNoButton)
			{
				<button class="win32-button" @onclick="() => HandleButtonClick(ButtonResult.No)">No</button>
			}
			@if (ShowAbortButton)
			{
				<button class="win32-button" @onclick="() => HandleButtonClick(ButtonResult.Abort)">Abort</button>
			}
			@if (ShowRetryButton)
			{
				<button class="win32-button" @onclick="() => HandleButtonClick(ButtonResult.Retry)">Retry</button>
			}
			@if (ShowIgnoreButton)
			{
				<button class="win32-button" @onclick="() => HandleButtonClick(ButtonResult.Ignore)">Ignore</button>
			}
		</div>
	</div>
</div>

@code {
	[Parameter]
	public required MessageBoxInfo Info { get; set; }
	
	[Parameter]
	public EventCallback<int> OnResult { get; set; }
	
	// Win32 MessageBox button combinations (should match Win32 API MB_* values)
	// These are duplicated here for UI rendering without coupling to emulator internals
	private const uint MB_OK = 0x00000000;
	private const uint MB_OKCANCEL = 0x00000001;
	private const uint MB_ABORTRETRYIGNORE = 0x00000002;
	private const uint MB_YESNOCANCEL = 0x00000003;
	private const uint MB_YESNO = 0x00000004;
	private const uint MB_RETRYCANCEL = 0x00000005;
	
	// Mask to extract button type from uType flags
	private const uint MB_TYPEMASK = 0x0F;
	
	// Win32 MessageBox return values (should match Win32 API ID* values)
	private enum ButtonResult
	{
		Ok = 1,      // IDOK
		Cancel = 2,  // IDCANCEL
		Abort = 3,   // IDABORT
		Retry = 4,   // IDRETRY
		Ignore = 5,  // IDIGNORE
		Yes = 6,     // IDYES
		No = 7       // IDNO
	}
	
	private bool ShowOkButton => (Info.Type & MB_TYPEMASK) == MB_OK || (Info.Type & MB_TYPEMASK) == MB_OKCANCEL;
	private bool ShowCancelButton => (Info.Type & MB_TYPEMASK) == MB_OKCANCEL || (Info.Type & MB_TYPEMASK) == MB_YESNOCANCEL || (Info.Type & MB_TYPEMASK) == MB_RETRYCANCEL;
	private bool ShowYesButton => (Info.Type & MB_TYPEMASK) == MB_YESNOCANCEL || (Info.Type & MB_TYPEMASK) == MB_YESNO;
	private bool ShowNoButton => (Info.Type & MB_TYPEMASK) == MB_YESNOCANCEL || (Info.Type & MB_TYPEMASK) == MB_YESNO;
	private bool ShowAbortButton => (Info.Type & MB_TYPEMASK) == MB_ABORTRETRYIGNORE;
	private bool ShowRetryButton => (Info.Type & MB_TYPEMASK) == MB_ABORTRETRYIGNORE || (Info.Type & MB_TYPEMASK) == MB_RETRYCANCEL;
	private bool ShowIgnoreButton => (Info.Type & MB_TYPEMASK) == MB_ABORTRETRYIGNORE;
	
	private async Task HandleButtonClick(ButtonResult result)
	{
		await OnResult.InvokeAsync((int)result);
	}
	
	private async Task HandleBackdropClick()
	{
		// Click outside the message box acts as Cancel (if available) or OK
		if (ShowCancelButton)
		{
			await HandleButtonClick(ButtonResult.Cancel);
		}
		else if (ShowOkButton)
		{
			await HandleButtonClick(ButtonResult.Ok);
		}
	}
}
