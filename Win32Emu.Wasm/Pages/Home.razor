	private string FormatFileSize(long bytes)
	{
		string[] sizes = { "B", "KB", "MB", "GB" };
		double len = bytes;
		int order = 0;
		while (len >= 1024 && order < sizes.Length - 1)
		{
			order++;
			len = len / 1024;
		}
		return $"{len:0.##} {sizes[order]}";
	}

	/// <summary>
	/// Load a sample executable from the wwwroot/samples directory
	/// </summary>
	private async Task LoadSampleExecutable(string fileName)
	{
		try
		{
			AddDebugOutput($"Loading sample: {fileName}");
			
			// Fetch the sample executable from wwwroot/samples
			var response = await JS.InvokeAsync<string>("fetch", $"samples/{fileName}");
			if (string.IsNullOrEmpty(response))
			{
				AddDebugOutput($"Failed to load sample: {fileName}");
				return;
			}
			
			// Convert response to byte array
			var bytes = await JS.InvokeAsync<byte[]>("fetchBinary", $"samples/{fileName}");
			if (bytes == null || bytes.Length == 0)
			{
				AddDebugOutput($"Failed to download sample: {fileName}");
				return;
			}
			
			_executableData = bytes;
			_loadedFileName = fileName;
			_loadedFileSize = bytes.Length;
			_executableLoaded = true;
			_folderMode = false;
			_loadedFiles.Clear();
			_discoveredExecutables.Clear();
			
			AddDebugOutput($"Sample loaded: {fileName} ({FormatFileSize(_loadedFileSize)})");
			Logger.LogInformation("Sample executable loaded: {FileName} ({Size} bytes)", fileName, _loadedFileSize);
			
			StateHasChanged();
		}
		catch (Exception ex)
		{
			AddDebugOutput($"Error loading sample: {ex.Message}");
			Logger.LogError(ex, "Error loading sample executable");
		}
	}

