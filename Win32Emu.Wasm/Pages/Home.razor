@page "/"
@implements IDisposable
@using System.Text
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@inject Win32Emu.Wasm.Services.EmulatorService EmulatorService
@inject Win32Emu.Wasm.Services.WasmDebugLogService DebugLogService

<PageTitle>Win32Emu - Web Emulator</PageTitle>

<div class="container-fluid">
	<div class="row">
		<div class="col-12 mb-3">
			<h1>🖥️ Win32Emu - Web Emulator</h1>
			<p class="lead">Run classic Windows applications in your browser</p>
		</div>
	</div>

	<div class="row">
		<div class="col-md-8">
			<!-- Display Area -->
			<div class="card mb-3">
				<div class="card-header">
					<strong>Display</strong>
					@if (_isRunning)
					{
						<span class="badge bg-success float-end">Running</span>
					}
					else
					{
						<span class="badge bg-secondary float-end">Stopped</span>
					}
				</div>
				<div class="card-body p-0">
					<div class="canvas-container" style="background-color: #000; min-height: 480px; display: flex; align-items: center; justify-content: center;">
						<canvas id="emulatorCanvas" 
								width="640" 
								height="480"
								style="max-width: 100%; height: auto; image-rendering: pixelated;">
						</canvas>
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-4">
			<!-- Controls -->
			<div class="card mb-3">
				<div class="card-header">
					<strong>Controls</strong>
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label class="form-label">Load Options</label>
						<div class="btn-group w-100 mb-2" role="group">
							<input type="radio" class="btn-check" name="loadMode" id="loadFile" checked="@(!_folderMode)" @onchange="() => SetLoadMode(false)" disabled="@_isRunning" />
							<label class="btn btn-outline-primary" for="loadFile">Single File</label>
							
							<input type="radio" class="btn-check" name="loadMode" id="loadFolder" checked="@_folderMode" @onchange="() => SetLoadMode(true)" disabled="@_isRunning" />
							<label class="btn btn-outline-primary" for="loadFolder">Folder</label>
						</div>
						
						@if (!_folderMode)
						{
							<label for="fileInput" class="form-label">Select Executable</label>
							<InputFile id="fileInput" 
									   OnChange="@HandleFileSelected" 
									   class="form-control" 
									   accept=".exe"
									   disabled="@_isRunning" />
						}
						else
						{
							<label for="folderInput" class="form-label">Select Folder</label>
							<input type="file" 
								   id="folderInput" 
								   class="form-control"
								   webkitdirectory
								   directory
								   multiple
								   @ref="_folderInputElement"
								   @onchange="HandleFolderSelected"
								   disabled="@_isRunning" />
						}
					</div>
					
					@* Show dropdown to select executable when multiple are found *@
					@if (_folderMode && _discoveredExecutables.Count > 1 && !_isRunning)
					{
						<div class="mb-3">
							<label for="executableSelect" class="form-label">Select Executable</label>
							<select id="executableSelect" 
									class="form-select"
									value="@_selectedExecutablePath"
									@onchange="OnExecutableSelectionChanged">
								@foreach (var exe in _discoveredExecutables)
								{
									<option value="@exe.RelativePath">@exe.RelativePath (@FormatFileSize(exe.Size))</option>
								}
							</select>
							<small class="text-muted">@_discoveredExecutables.Count executables found in folder</small>
						</div>
					}
					
					@if (_executableLoaded && !_isRunning)
					{
						<button class="btn btn-success w-100 mb-2" @onclick="StartEmulation">
							<i class="bi bi-play-fill"></i> Start
						</button>
					}
					
					@if (_isRunning)
					{
						<button class="btn btn-warning w-100 mb-2" @onclick="PauseEmulation">
							<i class="bi bi-pause-fill"></i> Pause
						</button>
						<button class="btn btn-danger w-100" @onclick="StopEmulation">
							<i class="bi bi-stop-fill"></i> Stop
						</button>
					}

					@if (!string.IsNullOrEmpty(_loadedFileName))
					{
						<div class="mt-3">
							<small class="text-muted">
								<strong>Loaded:</strong> @_loadedFileName
								<br />
								<strong>Size:</strong> @FormatFileSize(_loadedFileSize)
								@if (_folderMode && _loadedFiles.Count > 0)
								{
									<br />
									<strong>Files in folder:</strong> @_loadedFiles.Count
								}
							</small>
						</div>
					}
				</div>
			</div>

			<!-- Status Info -->
			<div class="card mb-3">
				<div class="card-header">
					<strong>Status</strong>
				</div>
				<div class="card-body">
					<div class="status-info">
						<div class="d-flex justify-content-between mb-2">
							<span>Instructions:</span>
							<strong>@_instructionsExecuted.ToString("N0")</strong>
						</div>
						<div class="d-flex justify-content-between mb-2">
							<span>FPS:</span>
							<strong>@_fps</strong>
						</div>
						<div class="d-flex justify-content-between mb-2">
							<span>Audio:</span>
							<strong>@(_audioEnabled ? "Enabled" : "Disabled")</strong>
						</div>
						<div class="d-flex justify-content-between">
							<span>VFS Files:</span>
							<strong>@EmulatorService.VfsFileCount</strong>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<!-- Standard Output -->
		<div class="col-md-6">
			<div class="card">
				<div class="card-header">
					<strong>Standard Output</strong>
					<button class="btn btn-sm btn-outline-secondary float-end" @onclick="ClearStdOut">
						Clear
					</button>
				</div>
				<div class="card-body p-0">
					<pre class="log-panel mb-0" style="height: 200px; overflow-y: auto; margin: 0; padding: 10px; background-color: #f8f9fa;">@_stdOutput</pre>
				</div>
			</div>
		</div>

		<!-- Debug Output -->
		<div class="col-md-6">
			<div class="card">
				<div class="card-header">
					<strong>Debug Output</strong>
					<button class="btn btn-sm btn-outline-secondary float-end" @onclick="ClearDebugOut">
						Clear
					</button>
				</div>
				<div class="card-body p-0">
					<pre class="log-panel mb-0" style="height: 200px; overflow-y: auto; margin: 0; padding: 10px; background-color: #f8f9fa;">@_debugOutput</pre>
				</div>
			</div>
		</div>
	</div>

	<!-- Note about current implementation -->
	<div class="row mt-3">
		<div class="col-12">
			<div class="alert alert-info">
				<h5 class="alert-heading">
					<i class="bi bi-info-circle-fill"></i> Development Status
				</h5>
				<p>
					This is a <strong>proof-of-concept</strong> Blazor WebAssembly frontend for Win32Emu.
					The emulator core now includes WASM-specific optimizations including SIMD intrinsics
					(via System.Runtime.Intrinsics.Wasm.PackedSimd) and Web Audio API integration.
				</p>
				<p class="mb-0">
					<strong>Completed features:</strong>
				</p>
				<ul class="mb-2">
					<li>✅ WASM-compatible rendering backend using HTML5 Canvas and JavaScript interop</li>
					<li>✅ Web Audio API integration for audio output with streaming support</li>
					<li>✅ WASM-compatible DirectDraw blitting with scalar operations</li>
					<li>✅ Safe code paths for all blitting operations (no unsafe pointers)</li>
					<li>✅ Full emulator core integration (LoadExecutableFromBytes)</li>
					<li>✅ WASM backend factory for rendering, audio, and input</li>
					<li>✅ EmulatorService for lifecycle management</li>
					<li>✅ Browser-based VFS for game data files (in-memory, case-insensitive)</li>
				</ul>
				<p class="mb-0">
					<strong>Remaining work:</strong>
				</p>
				<ul class="mb-0">
					<li>IndexedDB persistence for VFS (save games)</li>
					<li>Keyboard/Mouse input forwarding to emulated Windows</li>
					<li>Performance optimization for real-time emulation</li>
				</ul>
			</div>
		</div>
	</div>
</div>

@code {
	private bool _isRunning = false;
	private bool _executableLoaded = false;
	private bool _audioEnabled = false;
	private bool _folderMode = false;
	private string _loadedFileName = string.Empty;
	private long _loadedFileSize = 0;
	private byte[]? _executableData = null;
	private Dictionary<string, byte[]> _loadedFiles = new();
	private ElementReference _folderInputElement;
	
	// Track all executables found in a folder for user selection
	private List<ExecutableInfo> _discoveredExecutables = new();
	private string _selectedExecutablePath = string.Empty;
	
	private long _instructionsExecuted = 0;
	private int _fps = 0;
	
	private string _stdOutput = "No output yet.\n";
	private string _debugOutput = "No debug messages.\n";
	private readonly StringBuilder _debugOutputBuilder = new StringBuilder("No debug messages.\n");
	
	// Maximum number of characters to keep in debug output to prevent memory issues
	private const int MaxDebugOutputLength = 100000;
	// Buffer margin during log truncation to avoid frequent truncation operations
	private const int LogRotationBufferMargin = 1000;
	private const string LogTruncationPrefix = "... (older logs truncated) ...\n";
	
	/// <summary>
	/// Called when the component is initialized. Subscribe to the debug log service.
	/// </summary>
	protected override void OnInitialized()
	{
		// Subscribe to the centralized debug log service to receive logs from all backend components
		DebugLogService.LogReceived += OnBackendLogReceived;
	}
	
	/// <summary>
	/// Handle log messages from backend components (rendering, audio, input backends, etc.)
	/// </summary>
	private async void OnBackendLogReceived(object? sender, Win32Emu.Wasm.Services.WasmDebugLogEventArgs e)
	{
		try
		{
			await InvokeAsync(() =>
			{
				var formattedMessage = e.ToFormattedString() + "\n";
				_debugOutputBuilder.Append(formattedMessage);
				
				// Implement log rotation to prevent memory issues
				if (_debugOutputBuilder.Length > MaxDebugOutputLength)
				{
					// Keep the last portion of the log, ensuring we don't exceed string bounds
					var keepLength = MaxDebugOutputLength - LogTruncationPrefix.Length - LogRotationBufferMargin;
					var startIndex = _debugOutputBuilder.Length - keepLength;
					if (startIndex < 0) startIndex = 0;
					_debugOutputBuilder.Remove(0, startIndex);
					_debugOutputBuilder.Insert(0, LogTruncationPrefix);
				}
				
				_debugOutput = _debugOutputBuilder.ToString();
				StateHasChanged();
			});
		}
		catch (Exception ex)
		{
			// Log to browser console but don't crash the UI
			Logger.LogError(ex, "Error handling backend log message");
		}
	}
	
	/// <summary>
	/// Information about a discovered executable file
	/// </summary>
	private class ExecutableInfo
	{
		public string Name { get; set; } = string.Empty;
		public string RelativePath { get; set; } = string.Empty;
		public long Size { get; set; }
	}

	private void SetLoadMode(bool folderMode)
	{
		_folderMode = folderMode;
		_executableLoaded = false;
		_loadedFileName = string.Empty;
		_loadedFileSize = 0;
		_executableData = null;
		_loadedFiles.Clear();
		_discoveredExecutables.Clear();
		_selectedExecutablePath = string.Empty;
	}

	private async Task HandleFolderSelected(ChangeEventArgs e)
	{
		try
		{
			_loadedFiles.Clear();
			_discoveredExecutables.Clear();
			_selectedExecutablePath = string.Empty;
			_executableLoaded = false;
			_loadedFileName = string.Empty;
			
			// Get files from the folder using JavaScript interop
			var fileDataList = await JS.InvokeAsync<List<FileData>>("getFilesFromInput", "folderInput");
			
			if (fileDataList == null || fileDataList.Count == 0)
			{
				AddDebugOutput("No files selected from folder");
				return;
			}

			long totalSize = 0;

			foreach (var fileData in fileDataList)
			{
				_loadedFiles[fileData.RelativePath] = Convert.FromBase64String(fileData.Content);
				totalSize += fileData.Size;
				
				// Collect all executables for user selection
				if (fileData.Name.EndsWith(".exe", StringComparison.OrdinalIgnoreCase))
				{
					_discoveredExecutables.Add(new ExecutableInfo
					{
						Name = fileData.Name,
						RelativePath = fileData.RelativePath,
						Size = fileData.Size
					});
				}
			}

			if (_discoveredExecutables.Count > 0)
			{
				AddDebugOutput($"Loaded folder with {_loadedFiles.Count} files (Total: {FormatFileSize(totalSize)})");
				AddDebugOutput($"Found {_discoveredExecutables.Count} executable(s): {string.Join(", ", _discoveredExecutables.Select(x => x.Name))}");
				
				// Auto-select the first executable; null check below handles empty list edge case
				var firstExe = _discoveredExecutables.FirstOrDefault();
				if (firstExe != null)
				{
					SelectExecutable(firstExe.RelativePath);
				}
				
				Logger.LogInformation("Loaded folder with {FileCount} files, found {ExeCount} executables", _loadedFiles.Count, _discoveredExecutables.Count);
			}
			else
			{
				AddDebugOutput($"Error: No .exe file found in selected folder ({_loadedFiles.Count} files loaded)");
				_loadedFiles.Clear();
			}
		}
		catch (Exception ex)
		{
			AddDebugOutput($"Error loading folder: {ex.Message}");
			Logger.LogError(ex, "Error loading folder");
		}
	}
	
	/// <summary>
	/// Selects an executable from the discovered executables list
	/// </summary>
	private void SelectExecutable(string relativePath)
	{
		var exeInfo = _discoveredExecutables.FirstOrDefault(x => x.RelativePath == relativePath);
		if (exeInfo == null)
		{
			Logger.LogWarning("Executable not found in discovered list: {RelativePath}", relativePath);
			AddDebugOutput($"Error: Executable not found in discovered list: {relativePath}");
			return;
		}
		
		if (!_loadedFiles.TryGetValue(relativePath, out var exeData))
		{
			Logger.LogWarning("Executable data not found in loaded files: {RelativePath}", relativePath);
			AddDebugOutput($"Error: Executable data not found in loaded files: {relativePath}");
			return;
		}
		
		_selectedExecutablePath = relativePath;
		_executableData = exeData;
		_loadedFileName = exeInfo.Name;
		_loadedFileSize = exeInfo.Size;
		_executableLoaded = true;
		
		AddDebugOutput($"Selected executable: {_loadedFileName} ({FormatFileSize(_loadedFileSize)})");
	}
	
	/// <summary>
	/// Handles selection change from the executable dropdown
	/// </summary>
	private void OnExecutableSelectionChanged(ChangeEventArgs e)
	{
		var selectedPath = e.Value?.ToString();
		if (!string.IsNullOrEmpty(selectedPath))
		{
			SelectExecutable(selectedPath);
		}
	}

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
	{
		var file = e.File;
		if (file != null)
		{
			try
			{
				_loadedFileName = file.Name;
				_loadedFileSize = file.Size;
				
				// Read file into memory
				using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024); // 100MB max
				using var ms = new MemoryStream();
				await stream.CopyToAsync(ms);
				_executableData = ms.ToArray();
				
				_executableLoaded = true;
				AddDebugOutput($"Loaded executable: {_loadedFileName} ({FormatFileSize(_loadedFileSize)})");
				
				Logger.LogInformation("Loaded executable: {FileName} ({Size} bytes)", _loadedFileName, _loadedFileSize);
			}
			catch (Exception ex)
			{
				AddDebugOutput($"Error loading file: {ex.Message}");
				Logger.LogError(ex, "Error loading executable");
			}
		}
	}

	private async Task StartEmulation()
	{
		if (_executableData == null)
		{
			AddDebugOutput("Error: No executable loaded");
			return;
		}

		_isRunning = true;
		AddDebugOutput("Starting emulation...");
		AddStdOutput("Win32Emu Emulator Starting\n");
		
		try
		{
			// Initialize canvas
			await JS.InvokeVoidAsync("initializeEmulator", "emulatorCanvas");
			
			// Initialize audio (requires user interaction for browser autoplay policies)
			try
			{
				_audioEnabled = await JS.InvokeAsync<bool>("initializeAudio");
				if (_audioEnabled)
				{
					AddDebugOutput("Audio: Initialized (Web Audio API)");
				}
				else
				{
					AddDebugOutput("Audio: Failed to initialize");
				}
			}
			catch (Exception ex)
			{
				AddDebugOutput($"Audio: Not available - {ex.Message}");
				Logger.LogWarning(ex, "Audio initialization failed");
				_audioEnabled = false;
			}
			
			// Subscribe to emulator events
			EmulatorService.OnDebugOutput += OnEmulatorDebugOutput;
			EmulatorService.OnStdOutput += OnEmulatorStdOutput;
			EmulatorService.OnStateChanged += OnEmulatorStateChanged;
			
			// Load the executable using the real emulator
			AddDebugOutput($"Loading PE executable: {_loadedFileName}");
			AddDebugOutput($"SIMD: {EmulatorService.GetSimdCapabilities()}");
			
			var loadSuccess = await EmulatorService.LoadExecutableAsync(
				_executableData, 
				_loadedFileName,
				_folderMode ? _loadedFiles : null);
			
			if (!loadSuccess)
			{
				AddDebugOutput("Failed to load executable");
				_isRunning = false;
				return;
			}
			
			AddDebugOutput("Executable loaded successfully");
			AddStdOutput("Executable loaded and ready\n");
			
			// Start the emulator
			var startSuccess = await EmulatorService.StartAsync();
			if (!startSuccess)
			{
				AddDebugOutput("Failed to start emulation");
				_isRunning = false;
				return;
			}
			
			// Start UI update loop
			_ = Task.Run(async () =>
			{
				while (_isRunning)
				{
					_instructionsExecuted = (long)EmulatorService.InstructionsExecuted;
					_fps = 60; // TODO: Get actual FPS from emulator
					
					await InvokeAsync(StateHasChanged);
					await Task.Delay(100); // Update UI at 10 FPS
				}
			});
		}
		catch (Exception ex)
		{
			AddDebugOutput($"Error starting emulation: {ex.Message}");
			Logger.LogError(ex, "Error starting emulation");
			_isRunning = false;
		}
	}
	
	private async void OnEmulatorDebugOutput(object? sender, string message)
	{
		await InvokeAsync(() =>
		{
			_debugOutput += message + "\n";
			StateHasChanged();
		});
	}
	
	private async void OnEmulatorStdOutput(object? sender, string message)
	{
		await InvokeAsync(() =>
		{
			_stdOutput += message;
			StateHasChanged();
		});
	}
	
	private async void OnEmulatorStateChanged(object? sender, Win32Emu.Wasm.Services.EmulatorStateChangedEventArgs e)
	{
		await InvokeAsync(() =>
		{
			_isRunning = e.IsRunning;
			StateHasChanged();
		});
	}

	private void PauseEmulation()
	{
		EmulatorService.Pause();
		AddDebugOutput("Emulation paused");
	}

	private async Task StopEmulation()
	{
		await EmulatorService.StopAsync();
		
		// Unsubscribe from events
		EmulatorService.OnDebugOutput -= OnEmulatorDebugOutput;
		EmulatorService.OnStdOutput -= OnEmulatorStdOutput;
		EmulatorService.OnStateChanged -= OnEmulatorStateChanged;
		
		_isRunning = false;
		_instructionsExecuted = 0;
		_fps = 0;
		AddDebugOutput("Emulation stopped");
		AddStdOutput("Emulator stopped\n");
	}

	private void ClearStdOut()
	{
		_stdOutput = string.Empty;
	}

	private void ClearDebugOut()
	{
		_debugOutputBuilder.Clear();
		_debugOutput = string.Empty;
	}

	private void AddStdOutput(string message)
	{
		_stdOutput += message;
		StateHasChanged();
	}

	private void AddDebugOutput(string message)
	{
		_debugOutput += $"[{DateTime.Now:HH:mm:ss}] {message}\n";
		StateHasChanged();
	}

	private string FormatFileSize(long bytes)
	{
		string[] sizes = { "B", "KB", "MB", "GB" };
		double len = bytes;
		int order = 0;
		while (len >= 1024 && order < sizes.Length - 1)
		{
			order++;
			len = len / 1024;
		}
		return $"{len:0.##} {sizes[order]}";
	}

	// Helper class for folder file data from JavaScript
	private class FileData
	{
		public string Name { get; set; } = string.Empty;
		public string RelativePath { get; set; } = string.Empty;
		public long Size { get; set; }
		public string Content { get; set; } = string.Empty; // Base64 encoded
	}
	
	/// <summary>
	/// Unsubscribe from emulator events to prevent memory leaks
	/// </summary>
	public void Dispose()
	{
		// Unsubscribe from debug log service
		DebugLogService.LogReceived -= OnBackendLogReceived;
		
		// Unsubscribe from emulator service events
		EmulatorService.OnDebugOutput -= OnEmulatorDebugOutput;
		EmulatorService.OnStdOutput -= OnEmulatorStdOutput;
		EmulatorService.OnStateChanged -= OnEmulatorStateChanged;
	}
}
