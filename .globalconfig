is_global = true

# Code Analysis Configuration for Win32Emu
# This file suppresses warnings that are:
# 1. Not critical for this emulator project
# 2. Too numerous to fix without extensive refactoring
# 3. Incompatible with Win32 API emulation requirements

# CA1848: Use LoggerMessage delegates instead of LoggerExtensions
# Suppressed: Performance optimization, not critical for emulator
# 4952 instances would require extensive refactoring
dotnet_diagnostic.CA1848.severity = none

# CA1051: Do not declare visible instance fields
# Suppressed: Common pattern in emulator code for performance
# Win32 structures often need public fields
dotnet_diagnostic.CA1051.severity = none

# CA1031: Do not catch general exception types
# Suppressed: Emulator needs to catch and handle all exceptions
# to prevent crashes and maintain emulation stability
dotnet_diagnostic.CA1031.severity = none

# CA2007: Consider calling ConfigureAwait on the awaited task
# Suppressed: Not needed for library code without UI context
dotnet_diagnostic.CA2007.severity = none

# CA1707: Identifiers should not contain underscores
# Suppressed: Win32 API naming conventions use underscores
# Maintaining compatibility with Win32 API is essential
dotnet_diagnostic.CA1707.severity = none

# CA1062: Validate arguments of public methods
# Suppressed: Extensive validation would impact performance
# Emulated Win32 APIs often trust caller
dotnet_diagnostic.CA1062.severity = none

# CA1822: Mark members as static
# Suppressed: Emulation code often needs instance context
dotnet_diagnostic.CA1822.severity = none

# CA1815: Override equals and operator equals on value types
# Suppressed: Many Win32 structures don't need equality comparison
dotnet_diagnostic.CA1815.severity = none

# CA1034: Nested types should not be visible
# Suppressed: Win32 API structures are often nested
dotnet_diagnostic.CA1034.severity = none

# CA1063: Implement IDisposable Correctly
# Suppressed: Emulator has custom disposal patterns
dotnet_diagnostic.CA1063.severity = none

# CA2225: Operator overloads have named alternates
# Suppressed: Not always necessary for Win32 structures
dotnet_diagnostic.CA2225.severity = none

# CA1805: Do not initialize unnecessarily
# Suppressed: Explicit initialization improves code clarity
dotnet_diagnostic.CA1805.severity = none

# CA1727: Use PascalCase for named placeholders
# Suppressed: Win32 API uses specific naming conventions
dotnet_diagnostic.CA1727.severity = none

# CA1002: Do not expose generic lists
# Suppressed: Common pattern in API surface
dotnet_diagnostic.CA1002.severity = none

# CA2227: Collection properties should be read only
# Suppressed: Emulator needs mutable collections
dotnet_diagnostic.CA2227.severity = none

# CA1510: Use ArgumentNullException throw helper
# Suppressed: Maintaining compatibility with existing code
dotnet_diagnostic.CA1510.severity = none

# CA1816: Dispose methods should call SuppressFinalize
# Suppressed: Custom disposal patterns in emulator
dotnet_diagnostic.CA1816.severity = none

# CA1028: Enum Storage should be Int32
# Suppressed: Win32 APIs use various enum storage types
dotnet_diagnostic.CA1028.severity = none

# CA1860: Avoid using 'Enumerable.Any()' extension method
# Suppressed: Readability preference
dotnet_diagnostic.CA1860.severity = none

# CA2253: Named placeholders should not be numeric values
# Suppressed: Logging uses numeric placeholders in some cases
dotnet_diagnostic.CA2253.severity = none

# CA2022: Avoid inexact read with 'Stream.Read'
# Suppressed: Performance considerations in emulator
dotnet_diagnostic.CA2022.severity = none

# CA1508: Avoid dead conditional code
# Suppressed: May be false positives in complex emulation logic
dotnet_diagnostic.CA1508.severity = none

# CA2213: Disposable fields should be disposed
# Suppressed: Custom disposal patterns
dotnet_diagnostic.CA2213.severity = none

# CA1069: Enums values should not be duplicated
# Suppressed: Win32 APIs have duplicate enum values
dotnet_diagnostic.CA1069.severity = none

# CA2201: Do not raise reserved exception types
# Suppressed: Some exceptions are appropriate in emulation context
dotnet_diagnostic.CA2201.severity = none

# CA1849: Call async methods when in an async method
# Suppressed: Performance considerations
dotnet_diagnostic.CA1849.severity = none

# CA1720: Identifier contains type name
# Suppressed: Win32 API naming conventions
dotnet_diagnostic.CA1720.severity = none

# CA1008: Enums should have zero value
# Suppressed: Win32 APIs don't always have zero value
dotnet_diagnostic.CA1008.severity = none

# CA2254: Template should be a static expression
# Suppressed: Dynamic logging scenarios
dotnet_diagnostic.CA2254.severity = none

# CA1853: Unnecessary call to 'Dictionary.ContainsKey(key)'
# Suppressed: Readability preference
dotnet_diagnostic.CA1853.severity = none

# CA1819: Properties should not return arrays
# Suppressed: Win32 API structures often return arrays
dotnet_diagnostic.CA1819.severity = none

# CA5394: Do not use insecure randomness
# Suppressed: Emulator doesn't require cryptographic randomness
dotnet_diagnostic.CA5394.severity = none

# CA2000: Dispose objects before losing scope
# Suppressed: Custom lifetime management in emulator
dotnet_diagnostic.CA2000.severity = none

# CA1870: Use a cached 'SearchValues' instance
