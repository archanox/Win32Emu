<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Win32Emu.Gui.Views.DialogWindow"
        Width="400"
        Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    
    <Grid Margin="10">
        <!-- Dialog content will be dynamically created in code-behind -->
        <Panel Name="DialogContentPanel" />
    </Grid>
</Window>
