@page "/"
@using PeNet
@using System.Text.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Win32Emu Executable Analyzer</PageTitle>

<div class="container">
	<h1>🔍 Win32Emu Executable Analyzer</h1>
	<p class="subtitle">Upload a Windows executable (.exe or .dll) to check compatibility with Win32Emu</p>
	<p class="format-info">Supports PE32 (Win32 32-bit), PE32+ (Win64), and NE (Win16) formats</p>

	<div class="upload-section">
		<InputFile OnChange="HandleFileSelected" accept=".exe,.dll" class="file-input" />
		
		@if (isProcessing)
		{
			<div class="loading">
				<div class="spinner"></div>
				<p>Analyzing executable...</p>
			</div>
		}
	</div>

	@if (!string.IsNullOrEmpty(errorMessage))
	{
		<div class="alert alert-error">
			<strong>❌ Error:</strong> @errorMessage
		</div>
	}

	@if (analysisResult != null)
	{
		<div class="results">
			<h2>Analysis Results</h2>
			
			<div class="file-info">
				<h3>📄 File Information</h3>
				<table>
					<tr>
						<td><strong>File Name:</strong></td>
						<td>@analysisResult.FileName</td>
					</tr>
					<tr>
						<td><strong>File Size:</strong></td>
						<td>@FormatBytes(analysisResult.FileSize)</td>
					</tr>
					<tr>
						<td><strong>Format:</strong></td>
						<td>@analysisResult.Format</td>
					</tr>
					<tr>
						<td><strong>Architecture:</strong></td>
						<td>@(analysisResult.Is32Bit ? "32-bit (x86)" : analysisResult.Is16Bit ? "16-bit (x86)" : "64-bit (x64)")</td>
					</tr>
				</table>
			</div>

			@if (analysisResult.NeHeader != null)
			{
				<div class="file-info">
					<h3>📋 NE Header Details</h3>
					<table>
						<tr>
							<td><strong>Linker Version:</strong></td>
							<td>@analysisResult.NeHeader.LinkerVersion</td>
						</tr>
						<tr>
							<td><strong>Target OS:</strong></td>
							<td>@analysisResult.NeHeader.TargetOsName</td>
						</tr>
						<tr>
							<td><strong>Expected Windows Version:</strong></td>
							<td>@analysisResult.NeHeader.ExpectedWindowsVersion</td>
						</tr>
						<tr>
							<td><strong>DGroup Type:</strong></td>
							<td>@analysisResult.NeHeader.DGroupType</td>
						</tr>
						<tr>
							<td><strong>Entry Point (CS:IP):</strong></td>
							<td>@analysisResult.NeHeader.EntryPointFormatted</td>
						</tr>
						<tr>
							<td><strong>Initial Stack (SS:SP):</strong></td>
							<td>@analysisResult.NeHeader.InitialStackFormatted</td>
						</tr>
						<tr>
							<td><strong>Segment Count:</strong></td>
							<td>@analysisResult.NeHeader.SegmentCount</td>
						</tr>
						<tr>
							<td><strong>Module Reference Count:</strong></td>
							<td>@analysisResult.NeHeader.ModuleReferenceCount</td>
						</tr>
						<tr>
							<td><strong>Initial Heap Size:</strong></td>
							<td>@analysisResult.NeHeader.InitialHeapSize bytes</td>
						</tr>
						<tr>
							<td><strong>Initial Stack Size:</strong></td>
							<td>@analysisResult.NeHeader.InitialStackSize bytes</td>
						</tr>
						<tr>
							<td><strong>Auto Data Segment:</strong></td>
							<td>@analysisResult.NeHeader.AutoDataSegmentIndex</td>
						</tr>
						<tr>
							<td><strong>File CRC:</strong></td>
							<td>0x@analysisResult.NeHeader.FileCrc.ToString("X8")</td>
						</tr>
						<tr>
							<td><strong>File Alignment Shift:</strong></td>
							<td>@analysisResult.NeHeader.FileAlignmentShiftCount (sector size: @(analysisResult.NeHeader.FileAlignmentShiftCount == 0 ? 512 : (1 << analysisResult.NeHeader.FileAlignmentShiftCount)) bytes)</td>
						</tr>
						<tr>
							<td><strong>Resource Entry Count:</strong></td>
							<td>@analysisResult.NeHeader.ResourceEntryCount</td>
						</tr>
						<tr>
							<td><strong>Moveable Entry Points:</strong></td>
							<td>@analysisResult.NeHeader.MoveableEntryPointCount</td>
						</tr>
						@if (analysisResult.NeHeader.ProgramFlagsList.Any())
						{
							<tr>
								<td><strong>Program Flags:</strong></td>
								<td>@string.Join(", ", analysisResult.NeHeader.ProgramFlagsList)</td>
							</tr>
						}
						@if (analysisResult.NeHeader.ApplicationFlagsList.Any())
						{
							<tr>
								<td><strong>Application Flags:</strong></td>
								<td>@string.Join(", ", analysisResult.NeHeader.ApplicationFlagsList)</td>
							</tr>
						}
					</table>
				</div>
			}

			<div class="compatibility-verdict @GetVerdictClass()">
				<h3>🎯 Compatibility Verdict</h3>
				<p>@analysisResult.Status.Verdict</p>
			</div>

			<div class="stats-grid">
				<div class="stat-card">
					<div class="stat-value">@analysisResult.Status.TotalDlls</div>
					<div class="stat-label">Total DLLs</div>
				</div>
				<div class="stat-card">
					<div class="stat-value">@analysisResult.Status.TotalFunctions</div>
					<div class="stat-label">Total Functions</div>
				</div>
				<div class="stat-card success">
					<div class="stat-value">@analysisResult.Status.ImplementedFunctions</div>
					<div class="stat-label">Implemented</div>
				</div>
				<div class="stat-card warning">
					<div class="stat-value">@analysisResult.Status.StubFunctions</div>
					<div class="stat-label">Stubs</div>
				</div>
				<div class="stat-card error">
					<div class="stat-value">@analysisResult.Status.MissingFunctions</div>
					<div class="stat-label">Missing</div>
				</div>
			</div>

			<div class="progress-bar">
				<div class="progress-fill" style="width: @(analysisResult.Status.ImplementationPercentage)%">
					@analysisResult.Status.ImplementationPercentage.ToString("F1")% Compatible
				</div>
			</div>

			<h3>📚 DLL Dependencies</h3>
			@foreach (var dll in analysisResult.Dependencies)
			{
				<div class="dll-card @GetDllClass(dll)">
					<div class="dll-header">
						<h4>@dll.DllName</h4>
						<span class="badge @GetDllBadgeClass(dll)">
							@GetDllStatus(dll)
						</span>
					</div>
					<div class="dll-stats">
						<span>✅ @dll.ImplementedCount implemented</span>
						@if (dll.StubCount > 0)
						{
							<span>⚠️ @dll.StubCount stubs</span>
						}
						@if (dll.MissingCount > 0)
						{
							<span>❌ @dll.MissingCount missing</span>
						}
						<span>(@dll.ImplementationPercentage.ToString("F1")%)</span>
					</div>
					
					@if (showDetails)
					{
						<div class="function-list">
							@foreach (var func in dll.Functions.OrderBy(f => f.Status))
							{
								<div class="function-item @func.Status">
									<span class="function-name">@func.Name</span>
									<span class="function-status @func.Status">
										@func.Status.ToUpper()
									</span>
									@if (func.Ordinal.HasValue)
									{
										<span class="ordinal">Ordinal: @func.Ordinal</span>
									}
								</div>
							}
						</div>
					}
				</div>
			}

			<div class="actions">
				<button class="btn btn-primary" @onclick="ToggleDetails">
					@(showDetails ? "Hide" : "Show") Function Details
				</button>
				<button class="btn btn-secondary" @onclick="CopyUnimplemented">
					📋 Copy Unimplemented Functions
				</button>
			</div>
		</div>
	}
</div>

@code {
	private CompatibilityReport? analysisResult;
	private ApiStatusData? apiStatus;
	private Win16ApiStatusData? win16ApiStatus;
	private bool isProcessing;
	private bool showDetails;
	private string? errorMessage;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			// Load api-status.json (Win32 modules)
			var json = await Http.GetStringAsync("api-status.json");
			apiStatus = JsonSerializer.Deserialize<ApiStatusData>(json, new JsonSerializerOptions
			{
				PropertyNameCaseInsensitive = true
			});

			// Load win16-api-status.json (Win16 modules)
			var win16Json = await Http.GetStringAsync("win16-api-status.json");
			win16ApiStatus = JsonSerializer.Deserialize<Win16ApiStatusData>(win16Json, new JsonSerializerOptions
			{
				PropertyNameCaseInsensitive = true
			});
		}
		catch (Exception ex)
		{
			errorMessage = $"Failed to load API status data: {ex.Message}";
		}
	}

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
	{
		errorMessage = null;
		analysisResult = null;
		isProcessing = true;

		try
		{
			var file = e.File;
			
			if (file.Size > 100 * 1024 * 1024) // 100MB limit
			{
				errorMessage = "File is too large. Maximum size is 100MB.";
				return;
			}

			// Read file into memory
			using var memoryStream = new MemoryStream();
			await file.OpenReadStream(100 * 1024 * 1024).CopyToAsync(memoryStream);
			var fileBytes = memoryStream.ToArray();

			// Parse PE file
			await Task.Run(() => AnalyzePeFile(file.Name, fileBytes));
		}
		catch (Exception ex)
		{
			errorMessage = $"Error analyzing file: {ex.Message}";
		}
		finally
		{
			isProcessing = false;
		}
	}

	private void AnalyzePeFile(string fileName, byte[] fileBytes)
	{
		if (apiStatus == null)
		{
			errorMessage = "API status data not loaded";
			return;
		}

		// Detect file format (PE or NE)
		var format = DetectExecutableFormat(fileBytes);
		
		if (format == "Unknown")
		{
			errorMessage = "Unable to identify file format. Not a valid PE or NE executable.";
			return;
		}

		analysisResult = new CompatibilityReport
		{
			FileName = fileName,
			FileSize = fileBytes.Length,
			Format = format
		};

		if (format == "NE (Win16)")
		{
			AnalyzeNeFile(fileBytes);
			return;
		}

		// PE file analysis
		PeFile peFile;
		try
		{
			peFile = new PeFile(fileBytes);
		}
		catch (Exception ex)
		{
			// This shouldn't happen if format detection is working correctly,
			// but handle it gracefully in case of edge cases
			errorMessage = $"Error parsing PE file: {ex.Message}. The file may be corrupted or in an unsupported format.";
			return;
		}
		
		analysisResult.Is32Bit = !peFile.Is64Bit;
		analysisResult.Is64Bit = peFile.Is64Bit;
		analysisResult.Is16Bit = false;

		if (peFile.Is64Bit)
		{
			analysisResult.Status.Verdict = "INCOMPATIBLE - 64-bit PE files are not supported by Win32Emu";
			return;
		}

		var imports = peFile.ImportedFunctions;
		if (imports == null || !imports.Any())
		{
			analysisResult.Status.Verdict = "No imports found - may be statically linked or packed";
			return;
		}

		// Group imports by DLL
		var importsByDll = imports
			.Where(i => !string.IsNullOrEmpty(i.DLL) && !string.IsNullOrEmpty(i.Name))
			.GroupBy(i => i.DLL.ToUpperInvariant())
			.OrderBy(g => g.Key)
			.ToList();

		foreach (var dllGroup in importsByDll)
		{
			var dllName = dllGroup.Key;
			var functions = dllGroup.ToList();

			// Find matching module in API status
			var module = apiStatus.Modules
				.FirstOrDefault(m => m.Name.Equals(dllName, StringComparison.OrdinalIgnoreCase));

			var dependency = new DllDependency
			{
				DllName = dllName,
				IsSupported = module != null
			};

			foreach (var import in functions)
			{
				var functionName = import.Name ?? "";
				var ordinal = import.Hint;

				FunctionStatus status;
				
				if (module == null)
				{
					status = new FunctionStatus
					{
						Name = functionName,
						Status = "missing",
						Ordinal = ordinal
					};
					dependency.MissingCount++;
				}
				else
				{
					// Match by function name OR export name (for decorated names like _grAADrawLine@8)
					var function = module.Functions.FirstOrDefault(f => 
						f.Name.Equals(functionName, StringComparison.OrdinalIgnoreCase) ||
						(!string.IsNullOrEmpty(f.ExportName) && f.ExportName.Equals(functionName, StringComparison.OrdinalIgnoreCase)));

					if (function == null)
					{
						status = new FunctionStatus
						{
							Name = functionName,
							Status = "missing",
							Ordinal = ordinal
						};
						dependency.MissingCount++;
					}
					else if (function.IsStub)
					{
						status = new FunctionStatus
						{
							Name = functionName,
							Status = "stub",
							Ordinal = ordinal
						};
						dependency.StubCount++;
					}
					else
					{
						status = new FunctionStatus
						{
							Name = functionName,
							Status = "implemented",
							Ordinal = ordinal
						};
						dependency.ImplementedCount++;
					}
				}

				dependency.Functions.Add(status);
			}

			var totalFunctions = dependency.Functions.Count;
			dependency.ImplementationPercentage = totalFunctions > 0
				? (dependency.ImplementedCount * 100.0 / totalFunctions)
				: 0;

			analysisResult.Dependencies.Add(dependency);
		}

		// Calculate overall statistics
		analysisResult.Status.TotalDlls = analysisResult.Dependencies.Count;
		analysisResult.Status.TotalFunctions = analysisResult.Dependencies.Sum(d => d.Functions.Count);
		analysisResult.Status.ImplementedFunctions = analysisResult.Dependencies.Sum(d => d.ImplementedCount);
		analysisResult.Status.StubFunctions = analysisResult.Dependencies.Sum(d => d.StubCount);
		analysisResult.Status.MissingFunctions = analysisResult.Dependencies.Sum(d => d.MissingCount);
		
		if (analysisResult.Status.TotalFunctions > 0)
		{
			analysisResult.Status.ImplementationPercentage = 
				(analysisResult.Status.ImplementedFunctions * 100.0 / analysisResult.Status.TotalFunctions);
		}

		// Determine verdict
		if (analysisResult.Status.MissingFunctions == 0 && analysisResult.Status.StubFunctions == 0)
		{
			analysisResult.Status.Verdict = "FULLY COMPATIBLE - All required APIs are implemented";
		}
		else if (analysisResult.Status.MissingFunctions == 0 && analysisResult.Status.StubFunctions > 0)
		{
			analysisResult.Status.Verdict = $"MOSTLY COMPATIBLE - {analysisResult.Status.StubFunctions} stub(s) may affect functionality";
		}
		else if (analysisResult.Status.ImplementationPercentage >= 80)
		{
			analysisResult.Status.Verdict = $"PARTIALLY COMPATIBLE - {analysisResult.Status.MissingFunctions} missing function(s)";
		}
		else
		{
			analysisResult.Status.Verdict = $"LIMITED COMPATIBILITY - {analysisResult.Status.MissingFunctions} missing function(s)";
		}
	}

	private void ToggleDetails()
	{
		showDetails = !showDetails;
	}

	private async Task CopyUnimplemented()
	{
		if (analysisResult == null) return;

		var unimplemented = new List<string>();
		foreach (var dep in analysisResult.Dependencies)
		{
			var missing = dep.Functions.Where(f => f.Status != "implemented").ToList();
			if (missing.Any())
			{
				unimplemented.Add($"{dep.DllName}:");
				foreach (var func in missing)
				{
					unimplemented.Add($"  - {func.Name} ({func.Status})");
				}
				unimplemented.Add("");
			}
		}

		var text = string.Join("\n", unimplemented);
		// Note: Clipboard API requires user interaction and HTTPS in browser
		// This is a simplified version
		await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
	}

	private string GetVerdictClass()
	{
		if (analysisResult == null) return "";
		if (analysisResult.Status.Verdict.Contains("FULLY")) return "verdict-success";
		if (analysisResult.Status.Verdict.Contains("MOSTLY")) return "verdict-warning";
		if (analysisResult.Status.Verdict.Contains("PARTIALLY")) return "verdict-warning";
		return "verdict-error";
	}

	private string GetDllClass(DllDependency dll)
	{
		if (dll.MissingCount == 0 && dll.StubCount == 0) return "dll-complete";
		if (dll.MissingCount == 0) return "dll-partial";
		return "dll-missing";
	}

	private string GetDllBadgeClass(DllDependency dll)
	{
		if (dll.MissingCount == 0 && dll.StubCount == 0) return "badge-success";
		if (dll.MissingCount == 0) return "badge-warning";
		return "badge-error";
	}

	private string GetDllStatus(DllDependency dll)
	{
		if (dll.MissingCount == 0 && dll.StubCount == 0) return "COMPLETE";
		if (dll.MissingCount == 0) return "PARTIAL";
		return "INCOMPLETE";
	}

	private string FormatBytes(long bytes)
	{
		string[] sizes = { "B", "KB", "MB", "GB" };
		double len = bytes;
		int order = 0;
		while (len >= 1024 && order < sizes.Length - 1)
		{
			order++;
			len = len / 1024;
		}
		return $"{len:0.##} {sizes[order]}";
	}

	/// <summary>
	/// Returns a dictionary of supported Win16 modules and their functions.
	/// Data is loaded from win16-api-status.json which is auto-generated from Win16 module source files.
	/// </summary>
	private Dictionary<string, HashSet<string>> GetWin16SupportedModules()
	{
		var modules = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);

		if (win16ApiStatus?.Modules == null)
			return modules;

		foreach (var module in win16ApiStatus.Modules)
		{
			var functions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
			foreach (var function in module.Functions)
			{
				functions.Add(function);
			}
			modules[module.Name] = functions;
		}

		return modules;
	}

	private string DetectExecutableFormat(byte[] bytes)
	{
		// Magic numbers for format detection
		const int MinimumDosHeaderSize = 0x40;
		const int DosHeaderOffsetToNewHeader = 0x3C;
		const ushort MzSignature = 0x5A4D; // "MZ" in little-endian
		const ushort NeSignature = 0x454E; // "NE" in little-endian
		const ushort PeSignature = 0x4550; // "PE" in little-endian
		
		try
		{
			if (bytes.Length < MinimumDosHeaderSize)
				return "Unknown";

			// Check DOS MZ signature
			var mzSignature = BitConverter.ToUInt16(bytes, 0);
			if (mzSignature != MzSignature)
				return "Unknown";

			// Get offset to NE/PE header
			var headerOffset = BitConverter.ToUInt32(bytes, DosHeaderOffsetToNewHeader);
			if (headerOffset + 2 > bytes.Length)
				return "Unknown";

			// Check signature at header offset
			var signature = BitConverter.ToUInt16(bytes, (int)headerOffset);
			
			if (signature == NeSignature)
				return "NE (Win16)";
			
			if (signature == PeSignature)
				return "PE32 (Win32)";

			return "Unknown";
		}
		catch
		{
			return "Unknown";
		}
	}

	private void AnalyzeNeFile(byte[] fileBytes)
	{
		analysisResult!.Is32Bit = false;
		analysisResult.Is64Bit = false;
		analysisResult.Is16Bit = true;

		try
		{
			// Parse NE header information
			analysisResult.NeHeader = ParseNeHeader(fileBytes);
			
			// Parse NE header and imports
			var neImports = ParseNeImports(fileBytes);
			
			if (neImports.Count == 0)
			{
				analysisResult.Status.Verdict = "EXPERIMENTAL - Win16 NE format detected with no external module dependencies.";
				analysisResult.Status.TotalDlls = 0;
				analysisResult.Status.TotalFunctions = 0;
				analysisResult.Status.ImplementedFunctions = 0;
				analysisResult.Status.StubFunctions = 0;
				analysisResult.Status.MissingFunctions = 0;
				analysisResult.Status.ImplementationPercentage = 0;
				return;
			}

			// Get Win16 module support information
			var win16Modules = GetWin16SupportedModules();

			// Process imported modules and their functions
			foreach (var moduleImport in neImports)
			{
				var moduleName = moduleImport.Key;
				var importedFunctions = moduleImport.Value;

				var dllName = moduleName.ToUpperInvariant();
				if (!dllName.EndsWith(".DLL") && !dllName.EndsWith(".EXE"))
				{
					dllName += ".DLL";
				}

				// Check if this Win16 module is supported
				var isModuleSupported = win16Modules.TryGetValue(dllName, out var supportedFunctions);
				if (!isModuleSupported)
					supportedFunctions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

				var dependency = new DllDependency
				{
					DllName = dllName,
					IsSupported = isModuleSupported
				};

				// Check each imported function
				foreach (var importedFunc in importedFunctions)
				{
					var functionName = importedFunc.Name;
					var status = new FunctionStatus
					{
						Name = functionName,
						Ordinal = importedFunc.Ordinal
					};

					// Check if function is supported
					if (isModuleSupported && supportedFunctions!.Contains(functionName))
					{
						status.Status = "implemented";
						dependency.ImplementedCount++;
					}
					else
					{
						status.Status = "missing";
						dependency.MissingCount++;
					}

					dependency.Functions.Add(status);
				}

				var totalFunctions = dependency.Functions.Count;
				dependency.ImplementationPercentage = totalFunctions > 0
					? (dependency.ImplementedCount * 100.0 / totalFunctions)
					: 0;

				analysisResult.Dependencies.Add(dependency);
			}

			// Calculate overall statistics
			analysisResult.Status.TotalDlls = analysisResult.Dependencies.Count;
			analysisResult.Status.TotalFunctions = analysisResult.Dependencies.Sum(d => d.Functions.Count);
			analysisResult.Status.ImplementedFunctions = analysisResult.Dependencies.Sum(d => d.ImplementedCount);
			analysisResult.Status.StubFunctions = analysisResult.Dependencies.Sum(d => d.StubCount);
			analysisResult.Status.MissingFunctions = analysisResult.Dependencies.Sum(d => d.MissingCount);
			
			if (analysisResult.Status.TotalFunctions > 0)
			{
				analysisResult.Status.ImplementationPercentage = 
					(analysisResult.Status.ImplementedFunctions * 100.0 / analysisResult.Status.TotalFunctions);
			}

			// Determine verdict for Win16 files
			var supportedModuleCount = analysisResult.Dependencies.Count(d => d.IsSupported);
			
			if (analysisResult.Status.MissingFunctions == 0)
			{
				analysisResult.Status.Verdict = "FULLY COMPATIBLE - All Win16 APIs are implemented through thunking layer";
			}
			else if (analysisResult.Status.ImplementationPercentage >= 80)
			{
				analysisResult.Status.Verdict = $"MOSTLY COMPATIBLE - Win16 NE format. {analysisResult.Status.ImplementedFunctions}/{analysisResult.Status.TotalFunctions} functions supported ({supportedModuleCount}/{analysisResult.Status.TotalDlls} modules)";
			}
			else if (analysisResult.Status.ImplementationPercentage >= 50)
			{
				analysisResult.Status.Verdict = $"PARTIALLY COMPATIBLE - Win16 NE format. {analysisResult.Status.ImplementedFunctions}/{analysisResult.Status.TotalFunctions} functions supported ({supportedModuleCount}/{analysisResult.Status.TotalDlls} modules)";
			}
			else
			{
				analysisResult.Status.Verdict = $"LIMITED COMPATIBILITY - Win16 NE format. {analysisResult.Status.ImplementedFunctions}/{analysisResult.Status.TotalFunctions} functions supported ({supportedModuleCount}/{analysisResult.Status.TotalDlls} modules)";
			}
		}
		catch (Exception ex)
		{
			analysisResult.Status.Verdict = $"EXPERIMENTAL - Win16 NE format detected but import parsing failed: {ex.Message}";
			analysisResult.Status.TotalDlls = 0;
			analysisResult.Status.TotalFunctions = 0;
			analysisResult.Status.ImplementedFunctions = 0;
			analysisResult.Status.StubFunctions = 0;
			analysisResult.Status.MissingFunctions = 0;
			analysisResult.Status.ImplementationPercentage = 0;
		}
	}

	/// <summary>
	/// Parses the NE (New Executable) header to extract all header fields.
	/// </summary>
	/// <param name="fileBytes">The raw bytes of the NE executable</param>
	/// <returns>NeHeaderInfo object with parsed header data, or null if parsing fails</returns>
	private NeHeaderInfo? ParseNeHeader(byte[] fileBytes)
	{
		try
		{
			// Get offset to NE header from DOS header
			if (fileBytes.Length < 0x40)
				return null;

			var neHeaderOffset = BitConverter.ToUInt32(fileBytes, 0x3C);
			if (neHeaderOffset + 0x40 > fileBytes.Length) // Need at least 64 bytes for full NE header
				return null;

			// Verify NE signature
			if (fileBytes[neHeaderOffset] != 'N' || fileBytes[neHeaderOffset + 1] != 'E')
				return null;

			var header = new NeHeaderInfo
			{
				LinkerMajorVersion = fileBytes[neHeaderOffset + 0x02],
				LinkerMinorVersion = fileBytes[neHeaderOffset + 0x03],
				EntryTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x04),
				EntryTableLength = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x06),
				FileCrc = BitConverter.ToUInt32(fileBytes, (int)neHeaderOffset + 0x08),
				ProgramFlags = fileBytes[neHeaderOffset + 0x0C],
				ApplicationFlags = fileBytes[neHeaderOffset + 0x0D],
				AutoDataSegmentIndex = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x0E),
				InitialHeapSize = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x10),
				InitialStackSize = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x12),
				EntryPoint = BitConverter.ToUInt32(fileBytes, (int)neHeaderOffset + 0x14),
				InitialStack = BitConverter.ToUInt32(fileBytes, (int)neHeaderOffset + 0x18),
				SegmentCount = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x1C),
				ModuleReferenceCount = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x1E),
				NonResidentNamesTableSize = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x20),
				SegmentTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x22),
				ResourceTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x24),
				ResidentNamesTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x26),
				ModuleReferenceTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x28),
				ImportedNamesTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x2A),
				NonResidentNamesTableOffset = BitConverter.ToUInt32(fileBytes, (int)neHeaderOffset + 0x2C),
				MoveableEntryPointCount = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x30),
				FileAlignmentShiftCount = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x32),
				ResourceEntryCount = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x34),
				TargetOperatingSystem = fileBytes[neHeaderOffset + 0x36],
				Os2Flags = fileBytes[neHeaderOffset + 0x37],
				ReturnThunksOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x38),
				SegmentReferenceThunksOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x3A),
				MinimumCodeSwapSize = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x3C),
				ExpectedWindowsMinorVersion = fileBytes[neHeaderOffset + 0x3E],
				ExpectedWindowsMajorVersion = fileBytes[neHeaderOffset + 0x3F]
			};

			return header;
		}
		catch
		{
			return null;
		}
	}

	/// <summary>
	/// Parses the NE (New Executable) format to extract imported functions with module and function details.
	/// </summary>
	/// <param name="fileBytes">The raw bytes of the NE executable</param>
	/// <returns>Dictionary mapping module names to lists of imported function names/ordinals</returns>
	private Dictionary<string, List<NeImportedFunction>> ParseNeImports(byte[] fileBytes)
	{
		// NE format constants
		const int MinimumNeHeaderSize = 64;
		const int ModuleRefEntrySize = 2;
		const int ImportedEntrySize = 6;
		const byte ImportedSegmentIndicator = 0xFF;
		const byte FixedSegmentIndicator = 0xFE;
		const ushort OrdinalHighBitMask = 0x8000;
		const ushort OrdinalValueMask = 0x7FFF;
		const uint FixedEntrySize = 6u;
		const uint MoveableEntrySize = 3u;

		var importsByModule = new Dictionary<string, List<NeImportedFunction>>(StringComparer.OrdinalIgnoreCase);

		try
		{
			// Get offset to NE header from DOS header
			if (fileBytes.Length < 0x40)
				return importsByModule;

			var neHeaderOffset = BitConverter.ToUInt32(fileBytes, 0x3C);
			if (neHeaderOffset + MinimumNeHeaderSize > fileBytes.Length)
				return importsByModule;

			// Verify NE signature
			if (fileBytes[neHeaderOffset] != 'N' || fileBytes[neHeaderOffset + 1] != 'E')
				return importsByModule;

			// NE Header structure (key offsets from NE header start):
			// Offset 0x04 (2 bytes): Offset to Entry Table
			// Offset 0x06 (2 bytes): Length of Entry Table in bytes
			// Offset 0x1E (2 bytes): Number of entries in Module Reference Table
			// Offset 0x28 (2 bytes): Offset to Module Reference Table
			// Offset 0x2A (2 bytes): Offset to Imported Names Table

			var entryTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x04);
			var entryTableLength = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x06);
			var moduleRefCount = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x1E);
			var moduleRefTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x28);
			var importedNamesTableOffset = BitConverter.ToUInt16(fileBytes, (int)neHeaderOffset + 0x2A);

			// Read module names first
			var moduleNames = new List<string>();
			var absModuleRefTableOffset = neHeaderOffset + moduleRefTableOffset;
			var absImportedNamesTableOffset = neHeaderOffset + importedNamesTableOffset;

			for (int i = 0; i < moduleRefCount; i++)
			{
				if (absModuleRefTableOffset + (i * ModuleRefEntrySize) + 2 > fileBytes.Length)
					break;

				var nameOffset = BitConverter.ToUInt16(fileBytes, (int)absModuleRefTableOffset + (i * ModuleRefEntrySize));
				var absNameOffset = absImportedNamesTableOffset + nameOffset;

				if (absNameOffset >= fileBytes.Length)
				{
					moduleNames.Add($"UNKNOWN_MODULE_{i + 1}");
					continue;
				}

				var nameLength = fileBytes[absNameOffset];
				if (nameLength == 0 || absNameOffset + 1 + nameLength > fileBytes.Length)
				{
					moduleNames.Add($"UNKNOWN_MODULE_{i + 1}");
					continue;
				}

				var moduleName = System.Text.Encoding.ASCII.GetString(fileBytes, (int)absNameOffset + 1, nameLength);
				// Be more permissive - only skip if completely empty/whitespace
				if (string.IsNullOrWhiteSpace(moduleName))
				{
					moduleNames.Add($"UNKNOWN_MODULE_{i + 1}");
				}
				else
				{
					moduleNames.Add(moduleName);
				}
			}

			// Parse Entry Table to find imported functions
			var absEntryTableOffset = neHeaderOffset + entryTableOffset;
			var entryTableEnd = absEntryTableOffset + entryTableLength;
			var currentOffset = absEntryTableOffset;

			while (currentOffset < entryTableEnd && currentOffset < fileBytes.Length)
			{
				// Each bundle starts with a count byte
				var count = fileBytes[currentOffset];
				if (count == 0)
					break; // End of Entry Table

				currentOffset++;

				if (currentOffset >= fileBytes.Length)
					break;

				// Segment indicator byte
				var segmentIndicator = fileBytes[currentOffset];
				currentOffset++;

				// ImportedSegmentIndicator (0xFF) means imported entries
				if (segmentIndicator == ImportedSegmentIndicator)
				{
					// These are imported ordinals
					for (int i = 0; i < count; i++)
					{
						if (currentOffset + ImportedEntrySize > fileBytes.Length)
							break;

						// Read import entry (6 bytes):
						// Byte 0: Flags (unused)
						// Bytes 1-2: Module index (1-based)
						// Bytes 3-4: Import ordinal or name offset
						// Byte 5: Reserved

						// var flags = fileBytes[currentOffset]; // Unused, removed
						var moduleIndex = BitConverter.ToUInt16(fileBytes, (int)currentOffset + 1);
						var importOrdinal = BitConverter.ToUInt16(fileBytes, (int)currentOffset + 3);

						currentOffset += ImportedEntrySize;

						// Module index is 1-based
						if (moduleIndex > 0 && moduleIndex <= moduleNames.Count)
						{
							var moduleName = moduleNames[moduleIndex - 1];

							if (!importsByModule.ContainsKey(moduleName))
								importsByModule[moduleName] = new List<NeImportedFunction>();

							// Check if it's imported by name or ordinal
							// If high bit of importOrdinal is NOT set, it's a name reference
							if (importOrdinal < OrdinalHighBitMask)
							{
								// Import by name - importOrdinal is offset into Imported Names Table
								var functionNameOffset = absImportedNamesTableOffset + importOrdinal;
								if (functionNameOffset < fileBytes.Length)
								{
									var funcNameLength = fileBytes[functionNameOffset];
									if (funcNameLength > 0 && functionNameOffset + 1 + funcNameLength <= fileBytes.Length)
									{
										var functionName = System.Text.Encoding.ASCII.GetString(fileBytes, (int)functionNameOffset + 1, funcNameLength);
										if (!string.IsNullOrWhiteSpace(functionName))
										{
											importsByModule[moduleName].Add(new NeImportedFunction
											{
												Name = functionName,
												ImportedByOrdinal = false
											});
										}
									}
								}
							}
							else
							{
								// Import by ordinal
								var ordinal = (ushort)(importOrdinal & OrdinalValueMask);
								importsByModule[moduleName].Add(new NeImportedFunction
								{
									Name = $"Ordinal_{ordinal}",
									Ordinal = ordinal,
									ImportedByOrdinal = true
								});
							}
						}
					}
				}
				else
				{
					// Fixed or moveable segment entries - skip them
					// Each entry is 3 bytes for moveable, 6 bytes for fixed
					uint entrySize = (segmentIndicator == FixedSegmentIndicator) ? FixedEntrySize : MoveableEntrySize;
					currentOffset += count * entrySize;
				}
			}

			// Note: If no imports found through Entry Table, we still return the empty dictionary
			// Module names without functions will be handled by the UI
		}
		catch (Exception)
		{
			// If parsing fails, return what we have so far
		}

		return importsByModule;
	}

	/// <summary>
	/// Represents an imported function in a NE (Win16) executable.
	/// </summary>
	private class NeImportedFunction
	{
		public string Name { get; set; } = "";
		public ushort? Ordinal { get; set; }
		public bool ImportedByOrdinal { get; set; }
	}

	// Data models
	public class CompatibilityReport
	{
		public string FileName { get; set; } = "";
		public long FileSize { get; set; }
		public string Format { get; set; } = "";
		public bool Is16Bit { get; set; }
		public bool Is32Bit { get; set; }
		public bool Is64Bit { get; set; }
		public OverallStatus Status { get; set; } = new();
		public List<DllDependency> Dependencies { get; set; } = new();
		public NeHeaderInfo? NeHeader { get; set; }
	}

	public class OverallStatus
	{
		public int TotalDlls { get; set; }
		public int TotalFunctions { get; set; }
		public int ImplementedFunctions { get; set; }
		public int StubFunctions { get; set; }
		public int MissingFunctions { get; set; }
		public double ImplementationPercentage { get; set; }
		public string Verdict { get; set; } = "";
	}

	public class DllDependency
	{
		public string DllName { get; set; } = "";
		public bool IsSupported { get; set; }
		public List<FunctionStatus> Functions { get; set; } = new();
		public int ImplementedCount { get; set; }
		public int StubCount { get; set; }
		public int MissingCount { get; set; }
		public double ImplementationPercentage { get; set; }
	}

	public class FunctionStatus
	{
		public string Name { get; set; } = "";
		public string Status { get; set; } = "";
		public uint? Ordinal { get; set; }
	}

	public class ApiStatusData
	{
		public List<ModuleInfo> Modules { get; set; } = new();
	}

	public class ModuleInfo
	{
		public string Name { get; set; } = "";
		public List<FunctionInfo> Functions { get; set; } = new();
	}

	public class FunctionInfo
	{
		public string Name { get; set; } = "";
		public bool IsStub { get; set; }
		public string? ExportName { get; set; }
	}

	public class Win16ApiStatusData
	{
		public List<Win16ModuleInfo> Modules { get; set; } = new();
	}

	public class Win16ModuleInfo
	{
		public string Name { get; set; } = "";
		public List<string> Functions { get; set; } = new();
	}

	public class NeHeaderInfo
	{
		public byte LinkerMajorVersion { get; set; }
		public byte LinkerMinorVersion { get; set; }
		public ushort EntryTableOffset { get; set; }
		public ushort EntryTableLength { get; set; }
		public uint FileCrc { get; set; }
		public byte ProgramFlags { get; set; }
		public byte ApplicationFlags { get; set; }
		public ushort AutoDataSegmentIndex { get; set; }
		public ushort InitialHeapSize { get; set; }
		public ushort InitialStackSize { get; set; }
		public uint EntryPoint { get; set; } // CS:IP
		public uint InitialStack { get; set; } // SS:SP
		public ushort SegmentCount { get; set; }
		public ushort ModuleReferenceCount { get; set; }
		public ushort NonResidentNamesTableSize { get; set; }
		public ushort SegmentTableOffset { get; set; }
		public ushort ResourceTableOffset { get; set; }
		public ushort ResidentNamesTableOffset { get; set; }
		public ushort ModuleReferenceTableOffset { get; set; }
		public ushort ImportedNamesTableOffset { get; set; }
		public uint NonResidentNamesTableOffset { get; set; }
		public ushort MoveableEntryPointCount { get; set; }
		public ushort FileAlignmentShiftCount { get; set; }
		public ushort ResourceEntryCount { get; set; }
		public byte TargetOperatingSystem { get; set; }
		public byte Os2Flags { get; set; }
		public ushort ReturnThunksOffset { get; set; }
		public ushort SegmentReferenceThunksOffset { get; set; }
		public ushort MinimumCodeSwapSize { get; set; }
		public byte ExpectedWindowsMinorVersion { get; set; }
		public byte ExpectedWindowsMajorVersion { get; set; }

		public string LinkerVersion => $"{LinkerMajorVersion}.{LinkerMinorVersion}";
		public string ExpectedWindowsVersion => $"{ExpectedWindowsMajorVersion}.{ExpectedWindowsMinorVersion}";
		public string EntryPointFormatted => $"{(EntryPoint >> 16):X4}:{(EntryPoint & 0xFFFF):X4}";
		public string InitialStackFormatted => $"{(InitialStack >> 16):X4}:{(InitialStack & 0xFFFF):X4}";
		public string TargetOsName => TargetOperatingSystem switch
		{
			0x00 => "Unknown",
			0x01 => "OS/2",
			0x02 => "Windows",
			0x03 => "European MS-DOS 4.x",
			0x04 => "Windows/386",
			0x05 => "BOSS (Borland Operating System Services)",
			_ => $"Unknown (0x{TargetOperatingSystem:X2})"
		};
		public string DGroupType => (ProgramFlags & 0x03) switch
		{
			0 => "None",
			1 => "Single Data",
			2 => "Multiple Data",
			3 => "Reserved",
			_ => "Unknown"
		};
		public List<string> ProgramFlagsList
		{
			get
			{
				var flags = new List<string>();
				if ((ProgramFlags & 0x04) != 0) flags.Add("Global initialization");
				if ((ProgramFlags & 0x08) != 0) flags.Add("Protected mode only");
				if ((ProgramFlags & 0x10) != 0) flags.Add("8086 instructions");
				if ((ProgramFlags & 0x20) != 0) flags.Add("80286 instructions");
				if ((ProgramFlags & 0x40) != 0) flags.Add("80386 instructions");
				if ((ProgramFlags & 0x80) != 0) flags.Add("8087 instructions");
				return flags;
			}
		}
		public List<string> ApplicationFlagsList
		{
			get
			{
				var flags = new List<string>();
				var appType = ApplicationFlags & 0x03;
				if (appType == 0x01) flags.Add("Full screen (not aware of Windows/P.M. API)");
				else if (appType == 0x02) flags.Add("Compatible with Windows/P.M. API");
				else if (appType == 0x03) flags.Add("Uses Windows/P.M. API");
				
				if ((ApplicationFlags & 0x08) != 0) flags.Add("First segment has code that loads application");
				if ((ApplicationFlags & 0x20) != 0) flags.Add("Errors in image/executable");
				if ((ApplicationFlags & 0x80) != 0) flags.Add("Library module");
				return flags;
			}
		}
	}
}
