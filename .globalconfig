# CA1708: Identifiers should differ by more than case
# Suppressed: Win32 API naming conventions
dotnet_diagnostic.CA1708.severity = none

# CA1512: Use ArgumentOutOfRangeException throw helper
# Suppressed: Maintaining compatibility with existing code
dotnet_diagnostic.CA1512.severity = none

# CA1027: Mark enums with FlagsAttribute
# Suppressed: Win32 enums don't always use Flags
dotnet_diagnostic.CA1027.severity = none

# CA1001: Types that own disposable fields should be disposable
# Suppressed: Custom disposal patterns
dotnet_diagnostic.CA1001.severity = none

# CA2216: Disposable types should declare finalizer
# Suppressed: Finalizers not always needed
dotnet_diagnostic.CA2216.severity = none

# CA2014: Do not use stackalloc in loops
# Suppressed: Performance-critical code may need this
dotnet_diagnostic.CA2014.severity = none

# CA1869: Cache and reuse 'JsonSerializerOptions' instances
# Suppressed: May not apply to all scenarios
dotnet_diagnostic.CA1869.severity = none

# CA1865: Use char overload
# Suppressed: Minor optimization
dotnet_diagnostic.CA1865.severity = none

# CA1859: Use concrete types when possible for improved performance
# Suppressed: Interface usage for flexibility
dotnet_diagnostic.CA1859.severity = none

# CA1846: Prefer 'AsSpan' over 'Substring'
# Suppressed: Readability preference
dotnet_diagnostic.CA1846.severity = none

# CA1725: Parameter names should match base declaration
# Suppressed: Win32 API naming conventions
dotnet_diagnostic.CA1725.severity = none

# CA1724: Type names should not match namespaces
# Suppressed: Win32 API naming conventions
dotnet_diagnostic.CA1724.severity = none

# CA1416: Validate platform compatibility
# Suppressed: Cross-platform emulator handles platform differences
dotnet_diagnostic.CA1416.severity = none

# CA1024: Use properties where appropriate
# Suppressed: Win32 API uses methods for operations
dotnet_diagnostic.CA1024.severity = none

# CA1823: Avoid unused private fields
