	/// <summary>
	/// Subscribe to EmulatorHost events for windows/dialogs.
	/// This is called after LoadExecutableAsync returns and EmulatorHost is non-null.
	/// Guards against double subscription by tracking the currently subscribed host.
	/// </summary>
	private void SubscribeToEmulatorHost()
	{
		var currentHost = EmulatorService.EmulatorHost;
		
		// If already subscribed to this host, no-op
		if (currentHost == _subscribedHost)
		{
			return;
		}
		
		// Unsubscribe from previous host if different
		UnsubscribeFromEmulatorHost();
		
		// Subscribe to the new host (currentHost is guaranteed non-null)
		currentHost.WindowCreated += OnWindowCreated;
		currentHost.DialogCreateRequested += OnDialogCreateRequested;
		currentHost.MessageBoxRequested += OnMessageBoxRequested;
		currentHost.DialogEnded += OnDialogEnded;
		_subscribedHost = currentHost;
		
		AddDebugOutput("Subscribed to EmulatorHost events");
	}
	
	/// <summary>
	/// Unsubscribe from the currently subscribed EmulatorHost.
	/// </summary>
	private void UnsubscribeFromEmulatorHost()
	{
		if (_subscribedHost != null)
		{
			_subscribedHost.WindowCreated -= OnWindowCreated;
			_subscribedHost.DialogCreateRequested -= OnDialogCreateRequested;
			_subscribedHost.MessageBoxRequested -= OnMessageBoxRequested;
			_subscribedHost.DialogEnded -= OnDialogEnded;
			_subscribedHost = null;
		}
	}
	
