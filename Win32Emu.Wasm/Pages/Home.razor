	/// <summary>
	/// Handle dialog result from user interaction.
	/// </summary>
	private void HandleDialogResult(int result)
	{
		if (_activeDialogEventArgs != null)
		{
			AddDebugOutput($"Dialog result: {result}");
			// Use TrySetResult to avoid exceptions if already completed
			if (!_activeDialogEventArgs.CompletionSource.TrySetResult(result))
			{
				Logger.LogWarning("Dialog result was already set, ignoring duplicate completion");
			}
			_activeDialog = null;
			_activeDialogEventArgs = null;
			StateHasChanged();
		}
	}
	
	/// <summary>
	/// Handle message box result from user interaction.
	/// </summary>
	private void HandleMessageBoxResult(int result)
	{
		if (_activeMessageBoxEventArgs != null)
		{
			AddDebugOutput($"MessageBox result: {result}");
			// Use TrySetResult to avoid exceptions if already completed
			if (!_activeMessageBoxEventArgs.CompletionSource.TrySetResult(result))
			{
				Logger.LogWarning("MessageBox result was already set, ignoring duplicate completion");
			}
			_activeMessageBox = null;
			_activeMessageBoxEventArgs = null;
			StateHasChanged();
		}
	}
	
	/// <summary>
	/// Unsubscribe from emulator events to prevent memory leaks
	/// </summary>
	public void Dispose()
	{
		// Unsubscribe from debug log service
		DebugLogService.LogReceived -= OnBackendLogReceived;
		
		// Unsubscribe from emulator service events
		EmulatorService.OnDebugOutput -= OnEmulatorDebugOutput;
		EmulatorService.OnStdOutput -= OnEmulatorStdOutput;
		EmulatorService.OnStateChanged -= OnEmulatorStateChanged;
		
		// Unsubscribe from host events using the helper method
		UnsubscribeFromEmulatorHost();
	}
	
	private void AddDDrawLog(string message)
	{
		if (_ddrawCallsLog.StartsWith("Waiting for DirectDraw"))
		{
			_ddrawCallsLog = "";
		}
		
		var timestamp = DateTime.Now.ToString("HH:mm:ss.fff");
		_ddrawCallsLog += $"[{timestamp}] {message}\n";
		
		// Keep only last N lines
		var lines = _ddrawCallsLog.Split('\n').ToList();
		if (lines.Count > MAX_DDRAW_LOG_LINES)
		{
			lines.RemoveRange(0, lines.Count - MAX_DDRAW_LOG_LINES);
			_ddrawCallsLog = string.Join('\n', lines);
		}
	}
	
