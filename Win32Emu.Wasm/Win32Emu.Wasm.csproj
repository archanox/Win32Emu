<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AllowUnsafeBlocks is disabled as DirectDraw has been made WASM-safe using safe Span operations -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Enable WASM SIMD for better performance -->
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <!-- Enable exception handling for better debugging -->
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Win32Emu\Win32Emu.csproj" />
  </ItemGroup>

</Project>
