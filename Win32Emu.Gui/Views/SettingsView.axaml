<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Win32Emu.Gui.ViewModels"
             x:Class="Win32Emu.Gui.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="20">
            <TextBlock Text="Emulator Settings"
                      FontSize="24"
                      FontWeight="Bold"/>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel Spacing="20" MaxWidth="600">
                
                <!-- Rendering Backend -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Rendering Backend"
                             FontWeight="Bold"
                             FontSize="14"/>
                    <ComboBox ItemsSource="{Binding RenderingBackends}"
                            SelectedItem="{Binding RenderingBackend}"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Select the multimedia backend (SDL, GLFW, Vulkan, or Metal). SDL is the default and uses native APIs (Metal on macOS, Vulkan on Linux, DirectX 12 on Windows). GLFW uses OpenGL. Vulkan provides cross-platform GPU acceleration. Metal is macOS-only."
                             FontSize="12"
                             Opacity="0.7"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Input Backend -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Input Backend"
                             FontWeight="Bold"
                             FontSize="14"/>
                    <ComboBox ItemsSource="{Binding InputBackends}"
                            SelectedItem="{Binding InputBackend}"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Select the input backend (SDL or GLFW). SDL is the default and provides native controller, keyboard, and mouse support. GLFW is an alternative that uses OpenGL-based windowing."
                             FontSize="12"
                             Opacity="0.7"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- CPU Backend -->
                <StackPanel Spacing="8">
                    <TextBlock Text="CPU Emulator Backend"
                             FontWeight="Bold"
                             FontSize="14"/>
                    <ComboBox ItemsSource="{Binding CpuBackends}"
                            SelectedItem="{Binding CpuBackend}"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Select the CPU emulation backend. IcedCPU is the stable interpreter (default). JitCPU is the experimental JIT compiler with async support. Unicorn is a reference implementation for testing and validation."
                             FontSize="12"
                             Opacity="0.7"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Resolution Scale Factor -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Resolution Scale Factor"
                             FontWeight="Bold"
                             FontSize="14"/>
                    <ComboBox ItemsSource="{Binding ScaleFactors}"
                            SelectedItem="{Binding ResolutionScaleFactor}"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Upscale the game resolution by this factor (1x = native resolution)"
                             FontSize="12"
                             Opacity="0.7"/>
                </StackPanel>

                <!-- Reserved Memory -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Reserved Memory (MB)"
                             FontWeight="Bold"
                             FontSize="14"/>
                    <NumericUpDown Value="{Binding ReservedMemoryMb}"
                                 Minimum="64"
                                 Maximum="2048"
                                 Increment="64"
                                 HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Amount of memory to allocate for the emulated environment"
                             FontSize="12"
                             Opacity="0.7"/>
                </StackPanel>

                <!-- Windows Version -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Windows Version"
                             FontWeight="Bold"
                             FontSize="14"/>
                    <ComboBox ItemsSource="{Binding WindowsVersions}"
                            SelectedItem="{Binding WindowsVersion}"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="The Windows version to emulate for compatibility"
                             FontSize="12"
                             Opacity="0.7"/>
                </StackPanel>

                <!-- Debug Mode -->
                <StackPanel Spacing="8">
                    <CheckBox IsChecked="{Binding EnableDebugMode}"
                            Content="Enable Debug Mode"/>
                    <TextBlock Text="Enable enhanced debugging to catch memory access errors"
                             FontSize="12"
                             Opacity="0.7"
                             Margin="0,-8,0,0"/>
                </StackPanel>

                <!-- JIT Cache Management -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,20,0,0"
                        Margin="0,20,0,0">
                    <StackPanel Spacing="20">
                        <TextBlock Text="JIT Cache Management"
                                 FontWeight="Bold"
                                 FontSize="16"/>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="Clear JIT Compilation Cache"
                                     FontWeight="Bold"
                                     FontSize="14"/>
                            <TextBlock Text="The JIT compiler caches compiled code blocks to improve startup performance. If you experience issues, you can purge the cache."
                                     FontSize="12"
                                     Opacity="0.7"
                                     TextWrapping="Wrap"/>
                            <Button Command="{Binding PurgeJitCacheCommand}"
                                  Content="Purge JIT Cache"
                                  HorizontalAlignment="Left"
                                  Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CacheStatusMessage}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Margin="0,4,0,0"
                                     IsVisible="{Binding CacheStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Instruction Analyzer Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,20,0,0"
                        Margin="0,20,0,0">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Instruction Analyzer (Advanced)"
                                 FontWeight="Bold"
                                 FontSize="16"/>

                        <!-- Enable Instruction Analyzer -->
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding EnableInstructionAnalyzer}"
                                    Content="Enable Instruction Analyzer"/>
                            <TextBlock Text="Enable detailed instruction analysis for debugging (provides human-readable assembly output and register/memory usage information)"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Enable Legacy Instruction Decoding -->
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding EnableLegacyInstructionDecoding}"
                                    Content="Enable Legacy Instruction Decoding"/>
                            <TextBlock Text="Enable decoding of old/deprecated CPU instructions (Cyrix, MPX, ALTINST, etc.) for vintage software compatibility"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Force 32-bit Stack Operations -->
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding Force32BitStackOps}"
                                    Content="Force 32-bit Stack Operations"/>
                            <TextBlock Text="Force 32-bit operand size for stack operations (PUSH/POP/CALL/RET) in 32-bit mode. Improves Win32 compatibility but may break Win16 or mixed-mode code. (Default: enabled)"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Information Panel -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12"
                                CornerRadius="4"
                                IsVisible="{Binding EnableInstructionAnalyzer}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ℹ️ Instruction Analyzer Features"
                                         FontWeight="Bold"
                                         FontSize="13"/>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="The Instruction Analyzer provides:"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="12,4,0,0">
                                    <Run Text="• Human-readable assembly formatting"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="12,0,0,0">
                                    <Run Text="• Read/written register analysis"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="12,0,0,0">
                                    <Run Text="• Memory access pattern detection"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="12,0,0,4">
                                    <Run Text="• Virtual address calculation"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="11"
                                         Opacity="0.7"
                                         FontStyle="Italic">
                                    <Run Text="Note: This feature has minimal performance impact but is most useful when combined with debug logging."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- GDB Server Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,20,0,0"
                        Margin="0,20,0,0">
                    <StackPanel Spacing="20">
                        <TextBlock Text="GDB Server (Ghidra/IDA Integration)"
                                 FontWeight="Bold"
                                 FontSize="16"/>

                        <!-- Enable GDB Server -->
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding EnableGdbServer}"
                                    Content="Enable GDB Server"/>
                            <TextBlock Text="Start GDB server for remote debugging with Ghidra, IDA Pro, or GDB"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0"/>
                        </StackPanel>

                        <!-- GDB Server Port -->
                        <StackPanel Spacing="8" IsEnabled="{Binding EnableGdbServer}">
                            <TextBlock Text="GDB Server Port"
                                     FontWeight="Bold"
                                     FontSize="14"/>
                            <NumericUpDown Value="{Binding GdbServerPort}"
                                         Minimum="1024"
                                         Maximum="65535"
                                         Increment="1"
                                         HorizontalAlignment="Stretch"/>
                            <TextBlock Text="Port for GDB server to listen on (default: 1234)"
                                     FontSize="12"
                                     Opacity="0.7"/>
                        </StackPanel>

                        <!-- Pause on Start -->
                        <StackPanel Spacing="8" IsEnabled="{Binding EnableGdbServer}">
                            <CheckBox IsChecked="{Binding GdbPauseOnStart}"
                                    Content="Pause on Start"/>
                            <TextBlock Text="Pause emulation at entry point and wait for debugger to connect"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0"/>
                        </StackPanel>

                        <!-- Information Panel -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12"
                                CornerRadius="4"
                                IsVisible="{Binding EnableGdbServer}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ℹ️ How to Connect"
                                         FontWeight="Bold"
                                         FontSize="13"/>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="Once the game starts, the GDB server will be listening on port "/>
                                    <Run Text="{Binding GdbServerPort}" FontWeight="Bold"/>
                                    <Run Text="."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="0,4,0,0">
                                    <Run Text="Connect from Ghidra: "/>
                                    <Run FontFamily="Consolas" Text="Debugger → Connect → gdb → localhost:"/>
                                    <Run FontFamily="Consolas" Text="{Binding GdbServerPort}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="Connect from GDB: "/>
                                    <Run FontFamily="Consolas" Text="target remote localhost:"/>
                                    <Run FontFamily="Consolas" Text="{Binding GdbServerPort}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Virtual Disk Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,20,0,0"
                        Margin="0,20,0,0">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Virtual Disk (C: Drive)"
                                 FontWeight="Bold"
                                 FontSize="16"/>

                        <!-- Use Virtual Disk By Default -->
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding UseVirtualDiskByDefault}"
                                    Content="Use Virtual Disk by Default"/>
                            <TextBlock TextWrapping="Wrap"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0">
                                <Run Text="When enabled, each game gets its own virtual disk file (VHD/VHDX) as the C: drive. This isolates game saves and settings per-game."/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Virtual Disk Format -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Virtual Disk Format"
                                     FontWeight="Bold"
                                     FontSize="14"/>
                            <ComboBox ItemsSource="{Binding VirtualDiskFormats}"
                                    SelectedItem="{Binding VirtualDiskFormat}"
                                    HorizontalAlignment="Stretch"/>
                            <TextBlock Text="Format for auto-created virtual disks (VHD = Hyper-V, VHDX = Hyper-V Gen2, VMDK = VMware)"
                                     FontSize="12"
                                     Opacity="0.7"/>
                        </StackPanel>

                        <!-- Default Virtual Disk Size -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Default Virtual Disk Size (MB)"
                                     FontWeight="Bold"
                                     FontSize="14"/>
                            <NumericUpDown Value="{Binding DefaultVirtualDiskSizeMb}"
                                         Minimum="100"
                                         Maximum="10240"
                                         Increment="128"
                                         HorizontalAlignment="Stretch"/>
                            <TextBlock Text="Size of auto-created virtual disks (100 MB - 10 GB)"
                                     FontSize="12"
                                     Opacity="0.7"/>
                        </StackPanel>

                        <!-- Virtual Disks Directory -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Virtual Disks Directory"
                                     FontWeight="Bold"
                                     FontSize="14"/>
                            <TextBox Text="{Binding VirtualDisksDirectory}"
                                   Watermark="(Default: LocalAppData/Win32Emu/VirtualDisks)"
                                   HorizontalAlignment="Stretch"/>
                            <TextBlock Text="Directory where virtual disk files are stored"
                                     FontSize="12"
                                     Opacity="0.7"/>
                        </StackPanel>

                        <!-- Information Panel -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12"
                                CornerRadius="4">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ℹ️ Virtual Disk Information"
                                         FontWeight="Bold"
                                         FontSize="13"/>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="• Virtual disks are automatically created and formatted with FAT32"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="• Each game gets an isolated C: drive - no interaction with host filesystem"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="• ISO files can be mounted read-only for game installation"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="• Disks are dynamically sized and only use space as needed"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="• VHD and VHDX formats supported for creation; VMDK can be mounted but not created"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- OpenTelemetry Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,20,0,0"
                        Margin="0,20,0,0">
                    <StackPanel Spacing="20">
                        <TextBlock Text="OpenTelemetry (Observability)"
                                 FontWeight="Bold"
                                 FontSize="16"/>

                        <!-- Enable OpenTelemetry -->
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding EnableOpenTelemetry}"
                                    Content="Enable OpenTelemetry"/>
                            <TextBlock Text="Enable OpenTelemetry for distributed tracing, metrics collection, and monitoring across all emulator sessions"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Console Exporter -->
                        <StackPanel Spacing="8" IsEnabled="{Binding EnableOpenTelemetry}">
                            <CheckBox IsChecked="{Binding UseConsoleExporter}"
                                    Content="Console Exporter"/>
                            <TextBlock Text="Export telemetry data to the console for debugging and development"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- OTLP Exporter -->
                        <StackPanel Spacing="8" IsEnabled="{Binding EnableOpenTelemetry}">
                            <CheckBox IsChecked="{Binding UseOtlpExporter}"
                                    Content="OTLP Exporter"/>
                            <TextBlock Text="Export telemetry data to an OpenTelemetry Protocol (OTLP) endpoint (e.g., Jaeger, Grafana, Prometheus)"
                                     FontSize="12"
                                     Opacity="0.7"
                                     Margin="0,-8,0,0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- OTLP Endpoint -->
                        <StackPanel Spacing="8" IsEnabled="{Binding UseOtlpExporter}">
                            <TextBlock Text="OTLP Endpoint"
                                     FontWeight="Bold"
                                     FontSize="14"/>
                            <TextBox Text="{Binding OtlpEndpoint}"
                                   Watermark="http://localhost:4317"
                                   HorizontalAlignment="Stretch"/>
                            <TextBlock Text="The endpoint URL for the OTLP collector (default: http://localhost:4317)"
                                     FontSize="12"
                                     Opacity="0.7"/>
                        </StackPanel>

                        <!-- Information Panel -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12"
                                CornerRadius="4"
                                IsVisible="{Binding EnableOpenTelemetry}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ℹ️ OpenTelemetry Features"
                                         FontWeight="Bold"
                                         FontSize="13"/>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9">
                                    <Run Text="OpenTelemetry enables comprehensive observability:"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="12,4,0,0">
                                    <Run Text="• Distributed tracing for execution flow"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="12,0,0,0">
                                    <Run Text="• Metrics for instructions executed, API calls, memory usage"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="12,0,0,0">
                                    <Run Text="• .NET runtime metrics (GC, JIT, thread pool)"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.9"
                                         Margin="12,0,0,4">
                                    <Run Text="• Performance profiling and monitoring"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                         FontSize="11"
                                         Opacity="0.7"
                                         FontStyle="Italic">
                                    <Run Text="Note: Telemetry is initialized at application startup and runs for the entire Avalonia session, capturing logs from all emulator instances."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
