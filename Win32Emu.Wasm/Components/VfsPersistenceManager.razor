@using Win32Emu.Wasm.Services
@inject VfsPersistenceService PersistenceService
@inject ILogger<VfsPersistenceManager> Logger

<div class="card">
	<div class="card-header">
		<strong>💾 VFS Persistence</strong>
		<button class="btn btn-sm btn-outline-secondary float-end" @onclick="RefreshStates" disabled="@_isLoading">
			<i class="bi bi-arrow-clockwise"></i> Refresh
		</button>
	</div>
	<div class="card-body">
		@if (_isLoading)
		{
			<div class="text-center">
				<div class="spinner-border spinner-border-sm" role="status">
					<span class="visually-hidden">Loading...</span>
				</div>
				<span class="ms-2">Loading...</span>
			</div>
		}
		else
		{
			<!-- Save current VFS state -->
			<div class="mb-3">
				<label class="form-label">Save Current State</label>
				<div class="input-group">
					<input type="text" 
						   class="form-control" 
						   placeholder="Enter save name..." 
						   @bind="_saveName"
						   disabled="@(!CanSave || _isSaving)" />
					<button class="btn btn-success" 
							@onclick="SaveCurrentState" 
							disabled="@(!CanSave || _isSaving || string.IsNullOrWhiteSpace(_saveName))">
						@if (_isSaving)
						{
							<span class="spinner-border spinner-border-sm" role="status"></span>
							<span>Saving...</span>
						}
						else
						{
							<i class="bi bi-save"></i>
							<span>Save</span>
						}
					</button>
				</div>
				<small class="text-muted">Saves the current VFS files to browser storage</small>
			</div>

			<!-- Saved states list -->
			<div class="mb-3">
				<label class="form-label">Saved States (@_savedStates.Count)</label>
				
				@if (_savedStates.Count == 0)
				{
					<div class="alert alert-info mb-0">
						<small>No saved states yet. Save your current VFS state to persist it across sessions.</small>
					</div>
				}
				else
				{
					<div class="list-group" style="max-height: 300px; overflow-y: auto;">
						@foreach (var state in _savedStates.OrderByDescending(s => s.Timestamp))
						{
							<div class="list-group-item">
								<div class="d-flex w-100 justify-content-between align-items-start">
									<div class="flex-grow-1">
										<h6 class="mb-1">@state.Id</h6>
										<small class="text-muted">
											<i class="bi bi-file-earmark"></i> @state.ExecutableName
											<span class="ms-2"><i class="bi bi-files"></i> @state.FileCount files</span>
											<span class="ms-2"><i class="bi bi-clock"></i> @state.GetDateTime().ToString("g")</span>
										</small>
									</div>
									<div class="btn-group btn-group-sm" role="group">
										<button class="btn btn-outline-primary" 
												@onclick="() => LoadState(state.Id)" 
												disabled="@_isLoading"
												title="Load this state">
											<i class="bi bi-arrow-down-circle"></i> Load
										</button>
										<button class="btn btn-outline-danger" 
												@onclick="() => DeleteState(state.Id)" 
												disabled="@_isLoading"
												title="Delete this state">
											<i class="bi bi-trash"></i>
										</button>
									</div>
								</div>
							</div>
						}
					</div>
				}
			</div>

			<!-- Storage usage -->
			<div class="mb-3">
				<label class="form-label">Storage Usage</label>
				<div class="progress" style="height: 25px;">
					<div class="progress-bar @GetStorageBarClass()" 
						 role="progressbar" 
						 style="width: @(_storageUsage.UsagePercent)%"
						 aria-valuenow="@(_storageUsage.UsagePercent)" 
						 aria-valuemin="0" 
						 aria-valuemax="100">
						@(_storageUsage.UsagePercent.ToString("0.#"))%
					</div>
				</div>
				<small class="text-muted">
					@_storageUsage.FormatUsage() / @_storageUsage.FormatQuota() used
				</small>
			</div>

			<!-- Clear all button -->
			@if (_savedStates.Count > 0)
			{
				<button class="btn btn-outline-danger w-100" @onclick="ClearAllStates" disabled="@_isLoading">
					<i class="bi bi-trash3"></i> Clear All Saved States
				</button>
			}
		}
	</div>
</div>

@code {
	[Parameter]
	public bool CanSave { get; set; }

	[Parameter]
	public EventCallback<Dictionary<string, byte[]>> OnStateLoaded { get; set; }

	[Parameter]
	public IReadOnlyDictionary<string, byte[]>? CurrentVfsFiles { get; set; }

	[Parameter]
	public string? CurrentExecutableName { get; set; }

	private List<VfsStateMetadata> _savedStates = new();
	private StorageUsageInfo _storageUsage = new();
	private string _saveName = string.Empty;
	private bool _isLoading;
	private bool _isSaving;

	protected override async Task OnInitializedAsync()
	{
		await RefreshStates();
	}

	private async Task RefreshStates()
	{
		_isLoading = true;
		try
		{
			_savedStates = await PersistenceService.ListVfsStatesAsync();
			_storageUsage = await PersistenceService.GetStorageUsageAsync();
			StateHasChanged();
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Error refreshing VFS states");
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task SaveCurrentState()
	{
		if (string.IsNullOrWhiteSpace(_saveName))
		{
			return;
		}

		var files = CurrentVfsFiles;
		if (files == null || files.Count == 0)
		{
			Logger.LogWarning("Cannot save: No VFS files available");
			return;
		}

		_isSaving = true;
		try
		{
			var success = await PersistenceService.SaveVfsStateAsync(
				_saveName, 
				CurrentExecutableName, 
				files);

			if (success)
			{
				Logger.LogInformation("Successfully saved VFS state: {StateName}", _saveName);
				_saveName = string.Empty;
				await RefreshStates();
			}
			else
			{
				Logger.LogWarning("Failed to save VFS state: {StateName}", _saveName);
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Error saving VFS state");
		}
		finally
		{
			_isSaving = false;
		}
	}

	private async Task LoadState(string stateName)
	{
		_isLoading = true;
		try
		{
			var files = await PersistenceService.LoadVfsStateAsync(stateName);
			if (files != null)
			{
				Logger.LogInformation("Successfully loaded VFS state: {StateName} ({FileCount} files)", 
					stateName, files.Count);
				await OnStateLoaded.InvokeAsync(files);
			}
			else
			{
				Logger.LogWarning("Failed to load VFS state: {StateName}", stateName);
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Error loading VFS state");
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task DeleteState(string stateName)
	{
		_isLoading = true;
		try
		{
			var success = await PersistenceService.DeleteVfsStateAsync(stateName);
			if (success)
			{
				Logger.LogInformation("Successfully deleted VFS state: {StateName}", stateName);
				await RefreshStates();
			}
			else
			{
				Logger.LogWarning("Failed to delete VFS state: {StateName}", stateName);
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Error deleting VFS state");
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task ClearAllStates()
	{
		_isLoading = true;
		try
		{
			var success = await PersistenceService.ClearAllVfsStatesAsync();
			if (success)
			{
				Logger.LogInformation("Successfully cleared all VFS states");
				await RefreshStates();
			}
			else
			{
				Logger.LogWarning("Failed to clear all VFS states");
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Error clearing all VFS states");
		}
		finally
		{
			_isLoading = false;
		}
	}

	private string GetStorageBarClass()
	{
		return _storageUsage.UsagePercent switch
		{
			< 50 => "bg-success",
			< 75 => "bg-warning",
			_ => "bg-danger"
		};
	}
}
