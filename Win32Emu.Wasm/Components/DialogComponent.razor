@using Win32Emu
@using Win32Emu.Win32

<div class="win32-dialog-overlay" @onclick="HandleBackdropClick">
	<div class="win32-dialog" 
		 style="width: @(Info.Template.Width * DialogScaleFactor)px; height: @(Info.Template.Height * DialogScaleFactor)px;"
		 @onclick:stopPropagation="true">
		<div class="win32-dialog-titlebar">
			<span class="win32-dialog-title">@Info.Template.Title</span>
			<button class="win32-dialog-close" @onclick="HandleClose">×</button>
		</div>
		<div class="win32-dialog-content">
			@foreach (var item in Info.Template.Items)
			{
				<div class="win32-dialog-control" 
					 style="position: absolute; left: @(item.X * DialogScaleFactor)px; top: @(item.Y * DialogScaleFactor)px; width: @(item.Width * DialogScaleFactor)px; height: @(item.Height * DialogScaleFactor)px;">
					@RenderControl(item)
				</div>
			}
		</div>
	</div>
</div>

@code {
	[Parameter]
	public required DialogCreateInfo Info { get; set; }
	
	[Parameter]
	public EventCallback<int> OnResult { get; set; }
	
	// Dialog scaling factor to convert dialog units (DLU) to pixels
	// This assumes 8pt MS Sans Serif at 96 DPI (standard Windows dialog font)
	// At this DPI/font combination, 1 DLU ≈ 0.5 pixels, so we use 2x scaling
	private const int DialogScaleFactor = 2;
	
	// Win32 Dialog control styles (should match Win32 API values)
	// These are duplicated here for UI rendering without coupling to emulator internals
	private const uint BS_PUSHBUTTON = 0x00000000;
	private const uint BS_DEFPUSHBUTTON = 0x00000001;
	private const uint ES_LEFT = 0x00000000;
	private const uint ES_MULTILINE = 0x00000004;
	private const uint SS_LEFT = 0x00000000;
	private const uint SS_CENTER = 0x00000001;
	
	// Win32 Window styles (should match Win32 API values)
	private const uint WS_VISIBLE = 0x10000000;
	private const uint WS_DISABLED = 0x08000000;
	
	private readonly Dictionary<int, string> _controlValues = new();
	
	// Track if result has been submitted to prevent double-clicks
	private bool _resultSubmitted = false;
	
	private RenderFragment RenderControl(DialogItem item)
	{
		var className = item.WindowClass.ToUpperInvariant();
		var isVisible = (item.Style & WS_VISIBLE) != 0;
		var isDisabled = (item.Style & WS_DISABLED) != 0;
		
		if (!isVisible)
		{
			return @<text></text>;
		}
		
		// Standard Win32 control classes (ordinals are in decimal)
		// #128 = 0x80 = BUTTON
		// #129 = 0x81 = EDIT
		// #130 = 0x82 = STATIC
		// #131 = 0x83 = LISTBOX
		// #132 = 0x84 = SCROLLBAR
		// #133 = 0x85 = COMBOBOX
		return className switch
		{
			"BUTTON" or "#128" => RenderButton(item, isDisabled),
			"EDIT" or "#129" => RenderEdit(item, isDisabled),
			"STATIC" or "#130" => RenderStatic(item),
			"LISTBOX" or "#131" => RenderListBox(item, isDisabled),
			"COMBOBOX" or "#133" => RenderComboBox(item, isDisabled),
			"SCROLLBAR" or "#132" => RenderScrollBar(item, isDisabled),
			_ => RenderUnknown(item)
		};
	}
	
	private RenderFragment RenderButton(DialogItem item, bool isDisabled)
	{
		var isDefault = (item.Style & BS_DEFPUSHBUTTON) != 0;
		var cssClass = isDefault ? "win32-button win32-button-default" : "win32-button";
		
		return @<button class="@cssClass" 
						disabled="@isDisabled"
						@onclick="() => HandleControlClick(item.Id)">
			@item.Title
		</button>;
	}
	
	private RenderFragment RenderEdit(DialogItem item, bool isDisabled)
	{
		var isMultiline = (item.Style & ES_MULTILINE) != 0;
		if (!_controlValues.ContainsKey(item.Id))
		{
			_controlValues[item.Id] = item.Title;
		}
		
		if (isMultiline)
		{
			return @<textarea class="win32-edit win32-edit-multiline" 
							  disabled="@isDisabled"
							  @bind="_controlValues[item.Id]"></textarea>;
		}
		else
		{
			return @<input type="text" 
						   class="win32-edit" 
						   disabled="@isDisabled"
						   @bind="_controlValues[item.Id]" />;
		}
	}
	
	private RenderFragment RenderStatic(DialogItem item)
	{
		var alignment = (item.Style & SS_CENTER) != 0 ? "center" : "left";
		return @<div class="win32-static" style="text-align: @alignment">@item.Title</div>;
	}
	
	private RenderFragment RenderListBox(DialogItem item, bool isDisabled)
	{
		return @<select class="win32-listbox" size="5" disabled="@isDisabled">
			<option>@item.Title</option>
		</select>;
	}
	
	private RenderFragment RenderComboBox(DialogItem item, bool isDisabled)
	{
		return @<select class="win32-combobox" disabled="@isDisabled">
			<option>@item.Title</option>
		</select>;
	}
	
	private RenderFragment RenderScrollBar(DialogItem item, bool isDisabled)
	{
		// Scrollbars are rendered as a simple visual representation
		// Full scrollbar functionality would require more complex state management
		return @<div class="win32-scrollbar">
			<div class="win32-scrollbar-track"></div>
		</div>;
	}
	
	private RenderFragment RenderUnknown(DialogItem item)
	{
		return @<div class="win32-control-unknown">[@item.WindowClass]</div>;
	}
	
	private async Task HandleControlClick(int controlId)
	{
		// Prevent double-clicks by checking if result was already submitted
		if (_resultSubmitted)
		{
			return;
		}
		
		_resultSubmitted = true;
		// Handle button clicks by returning the control ID as the result
		await OnResult.InvokeAsync(controlId);
	}
	
	private async Task HandleClose()
	{
		// Prevent double-clicks
		if (_resultSubmitted)
		{
			return;
		}
		
		_resultSubmitted = true;
		// Return 0 to indicate dialog was cancelled
		await OnResult.InvokeAsync(0);
	}
	
	private async Task HandleBackdropClick()
	{
		// Prevent duplicate submissions - same check as HandleClose
		if (_resultSubmitted)
		{
			return;
		}
		
		// Click outside the dialog acts as cancel
		await HandleClose();
	}
}
