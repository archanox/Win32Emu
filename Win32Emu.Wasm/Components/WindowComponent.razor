@using Win32Emu

<div class="win32-window" 
	 style="left: @(Info.X)px; top: @(Info.Y)px; width: @(Info.Width)px; height: @(Info.Height)px;">
	<div class="win32-window-titlebar">
		<span class="win32-window-title">@Info.Title</span>
		<button class="win32-window-close" @onclick="HandleClose">×</button>
	</div>
	<div class="win32-window-content" style="padding: 0; overflow: hidden;">
		<!-- Canvas for DirectDraw rendering to this specific window -->
		<!-- The canvas ID format allows the rendering backend to target this window -->
		<canvas id="window-canvas-@(Info.Handle.ToString("X8"))"
				width="@Info.Width"
				height="@Info.Height"
				style="display: block; width: 100%; height: 100%; image-rendering: pixelated; background-color: #000;">
		</canvas>
	</div>
</div>

@code {
	[Parameter]
	public required WindowCreateInfo Info { get; set; }
	
	[Parameter]
	public EventCallback OnClose { get; set; }
	
	private async Task HandleClose()
	{
		await OnClose.InvokeAsync();
	}
}
